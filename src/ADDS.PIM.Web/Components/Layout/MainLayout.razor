@using System.Globalization
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inherits LayoutComponentBase
@implements IDisposable

@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
@inject IOperatorRequestClient RequestClient
@inject ICurrentPimActorContext CurrentActor
@inject ADDS.PIM.Application.Administration.IDirectoryAccountResolver DirectoryAccountResolver
@inject IStringLocalizer<SharedResources> Localizer

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @if (_isAdminSection)
            {
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        @for (var i = 0; i < _breadcrumbs.Count; i++)
                        {
                            var crumb = _breadcrumbs[i];
                            var isLast = i == _breadcrumbs.Count - 1;
                            <li class="breadcrumb-item @(isLast ? "active" : "")" aria-current="@(isLast ? "page" : null)">
                                @if (isLast)
                                {
                                    @crumb.Label
                                }
                                else
                                {
                                    <a href="@crumb.Href">@crumb.Label</a>
                                }
                            </li>
                        }
                    </ol>
                </nav>
            }
            else
            {
                <span></span>
            }
            <span class="welcome-message">
                <span>@Localizer["WelcomeGreeting"], @_displayName</span>
                <span class="welcome-message-badges"><MfaStatusBadge Status="_mfaStatus" /></span>
                <span class="dropdown language-switcher">
                    <button class="btn btn-sm btn-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Localizer["LanguageSwitcherLabel"]">
                        @CurrentLanguageFlag @CurrentLanguageLabel
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item @(IsCurrentCulture("de") ? "active" : "")" href="@BuildCultureSwitchUrl("de")">@GermanFlagSvg @Localizer["LanguageGerman"]</a></li>
                        <li><a class="dropdown-item @(IsCurrentCulture("en") ? "active" : "")" href="@BuildCultureSwitchUrl("en")">@UsFlagSvg @Localizer["LanguageEnglish"]</a></li>
                    </ul>
                </span>
            </span>
        </div>

        <article class="content px-4">
            <CascadingValue Value="_displayName" Name="CurrentUserDisplayName">
                @Body
            </CascadingValue>
        </article>
    </main>
</div>

@code {
    private Dictionary<string, string> SegmentLabels => new(StringComparer.OrdinalIgnoreCase)
    {
        ["admin"] = Localizer["SegmentAdmin"],
        ["persons"] = Localizer["SegmentPersons"],
        ["groups"] = Localizer["SegmentGroups"],
        ["entitlements"] = Localizer["SegmentEntitlements"],
        ["identity-purge"] = Localizer["SegmentIdentityPurge"],
        ["settings"] = Localizer["SegmentSettings"],
        ["directory-reconciliation"] = Localizer["SegmentDirectoryReconciliation"],
        ["audit-log"] = Localizer["SegmentAuditLog"],
        ["technical-errors"] = Localizer["SegmentTechnicalErrors"],
        ["ticket-reference-patterns"] = Localizer["SegmentTicketReferencePatterns"],
    };

    private string _displayName = "";
    private bool _isAdminSection;
    private List<(string Label, string Href)> _breadcrumbs = [];
    private MyMfaStatusResponse? _mfaStatus;

    protected override async Task OnInitializedAsync()
    {
        var identity = HttpContextAccessor.HttpContext?.User.Identity?.Name;
        _displayName = string.IsNullOrWhiteSpace(identity) ? Localizer["WelcomeFallback"] : identity.Split('\\').Last();
        await ResolveFriendlyDisplayNameAsync();
        UpdateSection();
        NavigationManager.LocationChanged += OnLocationChanged;
        await RefreshMfaStatusAsync();
    }

    private string BuildCultureSwitchUrl(string culture)
    {
        var redirectUri = Uri.EscapeDataString("/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
        return $"/culture/set?culture={culture}&redirectUri={redirectUri}";
    }

    private static bool IsCurrentCulture(string culture) =>
        string.Equals(CultureInfo.CurrentCulture.TwoLetterISOLanguageName, culture, StringComparison.OrdinalIgnoreCase);

    private static readonly MarkupString GermanFlagSvg = new(
        """<svg width="20" height="14" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true" class="flag-icon"><rect width="30" height="20" fill="#FFCE00" /><rect width="30" height="13.33" fill="#DD0000" /><rect width="30" height="6.67" fill="#000000" /></svg>""");

    private static readonly MarkupString UsFlagSvg = new(
        """<svg width="20" height="14" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true" class="flag-icon"><rect width="30" height="20" fill="#FFFFFF" /><rect y="0" width="30" height="1.54" fill="#B22234" /><rect y="3.08" width="30" height="1.54" fill="#B22234" /><rect y="6.15" width="30" height="1.54" fill="#B22234" /><rect y="9.23" width="30" height="1.54" fill="#B22234" /><rect y="12.31" width="30" height="1.54" fill="#B22234" /><rect y="15.38" width="30" height="1.54" fill="#B22234" /><rect y="18.46" width="30" height="1.54" fill="#B22234" /><rect width="12" height="10.77" fill="#3C3B6E" /></svg>""");

    private MarkupString CurrentLanguageFlag => IsCurrentCulture("en") ? UsFlagSvg : GermanFlagSvg;

    private LocalizedString CurrentLanguageLabel => IsCurrentCulture("en") ? Localizer["LanguageEnglish"] : Localizer["LanguageGerman"];

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateSection();
        _ = InvokeAsync(async () =>
        {
            await RefreshMfaStatusAsync();
            StateHasChanged();
        });
    }

    /// <summary>Best-effort: replaces the SAM-derived fallback with the current actor's AD display name. Never blocks or fails the page if the lookup is unavailable.</summary>
    private async Task ResolveFriendlyDisplayNameAsync()
    {
        try
        {
            var actor = await CurrentActor.ResolveAsync(CancellationToken.None);
            if (actor is null) return;
            var account = await DirectoryAccountResolver.ResolveAccountAsync(actor.ObjectGuid, CancellationToken.None);
            if (!string.IsNullOrWhiteSpace(account?.DisplayName)) _displayName = account.DisplayName;
        }
        catch { /* keep the SAM-derived fallback */ }
    }

    private async Task RefreshMfaStatusAsync()
    {
        try { _mfaStatus = await RequestClient.GetMfaStatusAsync(CancellationToken.None); }
        catch { _mfaStatus = null; }
    }

    private void UpdateSection()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        var queryIndex = relativePath.IndexOf('?');
        if (queryIndex >= 0)
        {
            relativePath = relativePath[..queryIndex];
        }

        _isAdminSection = relativePath.StartsWith("admin", StringComparison.OrdinalIgnoreCase);
        _breadcrumbs = _isAdminSection ? BuildBreadcrumbs(relativePath) : [];
    }

    private List<(string Label, string Href)> BuildBreadcrumbs(string relativePath)
    {
        var segments = relativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var crumbs = new List<(string Label, string Href)>();
        var href = "";
        var segmentLabels = SegmentLabels;

        foreach (var segment in segments)
        {
            href += "/" + segment;
            var label = Guid.TryParse(segment, out _) ? Localizer["DetailsLabel"] : segmentLabels.GetValueOrDefault(segment, segment);
            crumbs.Add((label, href));
        }

        return crumbs;
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["UnhandledErrorMessage"]
    <a href="." class="reload">@Localizer["ReloadLink"]</a>
    <span class="dismiss">🗙</span>
</div>

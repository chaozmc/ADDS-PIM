@page "/admin/directory-reconciliation"
@using Microsoft.Extensions.Localization
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminDirectoryReconciliation> Localizer
@inject ILogger<AdminDirectoryReconciliation> Logger

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["Heading"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_overview is null)
{
    <LoadingIndicator Message="@Localizer["LoadingMessage"]" />
}
else
{
    <section aria-labelledby="start-title">
        <h2 id="start-title">@Localizer["StartSectionTitle"]</h2>
        <p>@Localizer["StartSectionDescription"]</p>
        <button class="btn btn-primary" @onclick="StartAsync" disabled="@(_saving || HasActiveRun)"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> @Localizer["StartButton"]</button>
    </section>
    <section aria-labelledby="runs-title" class="mt-4">
        <h2 id="runs-title">@Localizer["RecentRunsTitle"]</h2>
        @if (_overview.Runs.Count == 0)
        {
            <EmptyState Icon="bi-clock-history" Title="@Localizer["NoRunsTitle"]" Description="@Localizer["NoRunsDescription"]" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>@Localizer["ColStarted"]</th><th>@Localizer["ColStatus"]</th><th>@Localizer["ColCompleted"]</th></tr></thead>
                    <tbody>
                        @foreach (var run in _overview.Runs)
                        {
                            <tr>
                                <td>@run.RequestedUtc.ToLocalTime().ToString("g")</td>
                                <td><StatusBadge Text="@run.Status" Variant="@RunStatusVariant(run.Status)" /></td>
                                <td>@(run.CompletedUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <section aria-labelledby="findings-title" class="mt-4">
        <h2 id="findings-title">@Localizer["FindingsTitle"]</h2>
        @if (_overview.Findings.Count == 0)
        {
            <EmptyState Icon="bi-check-circle" Title="@Localizer["NoFindingsTitle"]" Description="@Localizer["NoFindingsDescription"]" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>@Localizer["ColObject"]</th><th>@Localizer["ColType"]</th><th>@Localizer["ColFinding"]</th><th>@Localizer["ColDetected"]</th><th>@Localizer["ColStatus"]</th></tr></thead>
                    <tbody>
                        @foreach (var finding in _overview.Findings)
                        {
                            <tr>
                                <td>@finding.DisplayName</td>
                                <td>@finding.EntityType</td>
                                <td>@finding.Reason</td>
                                <td>@finding.DetectedUtc.ToLocalTime().ToString("g")</td>
                                <td><StatusBadge Text="@(finding.IsResolved ? Localizer["ResolvedStatus"].Value : Localizer["OpenStatus"].Value)" Variant="@(finding.IsResolved ? StatusBadge.BadgeVariant.Success : StatusBadge.BadgeVariant.Warning)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_overview.Findings.Any(finding => !finding.IsResolved))
    {
        <section class="mt-4" aria-labelledby="deactivate-title">
            <h2 id="deactivate-title">@Localizer["LocalDeactivationTitle"]</h2>
            <p>@Localizer["LocalDeactivationDescription"]</p>
            @foreach (var finding in _overview.Findings.Where(finding => !finding.IsResolved))
            {
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span><strong>@finding.DisplayName</strong> – @finding.Reason</span>
                        <button class="btn btn-outline-danger" @onclick="() => _pending = finding"><i class="bi bi-slash-circle" aria-hidden="true"></i> @Localizer["DeactivateButton"]</button>
                    </div>
                </div>
            }
            @if (_pending is not null)
            {
                <DangerZonePanel Message="@Localizer["DeactivateConfirmMessage", _pending.DisplayName].Value"
                                  ConfirmLabel="@Localizer["DeactivateConfirmLabel"]" IsBusy="_saving"
                                  OnConfirm="DeactivateAsync" OnCancel="() => _pending = null" />
            }
        </section>
    }
}

@code {
    private DirectoryReconciliationOverview? _overview;
    private string? _error;
    private bool _saving;
    private ManagedDirectoryReconciliationFinding? _pending;

    private bool HasActiveRun => _overview?.Runs.Any(run => run.Status is "Queued" or "Executing") == true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _error = null; _overview = await AdministrationClient.GetDirectoryReconciliationAsync(CancellationToken.None); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load directory reconciliation overview."); _error = Localizer["LoadError"]; }
    }

    private async Task StartAsync()
    {
        _saving = true;
        try { _error = null; await AdministrationClient.StartDirectoryReconciliationAsync(CancellationToken.None); await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to start directory reconciliation run."); _error = Localizer["StartError"]; }
        finally { _saving = false; }
    }

    private async Task DeactivateAsync()
    {
        var pending = _pending;
        if (pending is null) return;
        _saving = true;
        try { _error = null; await AdministrationClient.DeactivateDirectoryReconciliationFindingAsync(pending, CancellationToken.None); _pending = null; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to deactivate directory reconciliation finding {FindingId}.", pending.FindingId); _error = Localizer["DeactivateError"]; }
        finally { _saving = false; }
    }

    private static StatusBadge.BadgeVariant RunStatusVariant(string status) => status switch
    {
        "Succeeded" => StatusBadge.BadgeVariant.Success,
        "Failed" => StatusBadge.BadgeVariant.Danger,
        "Queued" or "Executing" => StatusBadge.BadgeVariant.Warning,
        _ => StatusBadge.BadgeVariant.Neutral
    };
}

@page "/admin/directory-reconciliation"
@inject IAdministrationClient AdministrationClient

<PageTitle>ADDS-PIM – AD-Abgleich</PageTitle>

<section class="hero">
    <div>
        <h1>AD-Abgleich</h1>
        <p>Prüft aktive PIM-Konten und Zielgruppen gegen Active Directory. Der Lauf ändert keine PIM-Daten.</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_overview is null)
{
    <LoadingIndicator Message="Abgleichdaten werden geladen …" />
}
else
{
    <section aria-labelledby="start-title">
        <h2 id="start-title">Abgleich starten</h2>
        <p>Gefundene Auffälligkeiten werden zur Prüfung gespeichert. Eine lokale Deaktivierung erfolgt erst nach einer ausdrücklichen Bestätigung.</p>
        <button class="btn btn-primary" @onclick="StartAsync" disabled="@(_saving || HasActiveRun)"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Abgleich starten</button>
    </section>
    <section aria-labelledby="runs-title" class="mt-4">
        <h2 id="runs-title">Letzte Läufe</h2>
        @if (_overview.Runs.Count == 0)
        {
            <EmptyState Icon="bi-clock-history" Title="Noch kein Abgleich durchgeführt" Description="Starten Sie oben den ersten Abgleichlauf." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Gestartet</th><th>Status</th><th>Abgeschlossen</th></tr></thead>
                    <tbody>
                        @foreach (var run in _overview.Runs)
                        {
                            <tr>
                                <td>@run.RequestedUtc.ToLocalTime().ToString("g")</td>
                                <td><StatusBadge Text="@run.Status" Variant="@RunStatusVariant(run.Status)" /></td>
                                <td>@(run.CompletedUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <section aria-labelledby="findings-title" class="mt-4">
        <h2 id="findings-title">Prüfbefunde</h2>
        @if (_overview.Findings.Count == 0)
        {
            <EmptyState Icon="bi-check-circle" Title="Keine Befunde vorhanden" Description="Bisherige Abgleichläufe haben keine Abweichungen zwischen PIM-Daten und Active Directory festgestellt." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Objekt</th><th>Typ</th><th>Befund</th><th>Erkannt</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var finding in _overview.Findings)
                        {
                            <tr>
                                <td>@finding.DisplayName</td>
                                <td>@finding.EntityType</td>
                                <td>@finding.Reason</td>
                                <td>@finding.DetectedUtc.ToLocalTime().ToString("g")</td>
                                <td><StatusBadge Text="@(finding.IsResolved ? "Erledigt" : "Offen")" Variant="@(finding.IsResolved ? StatusBadge.BadgeVariant.Success : StatusBadge.BadgeVariant.Warning)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (_overview.Findings.Any(finding => !finding.IsResolved))
    {
        <section class="mt-4" aria-labelledby="deactivate-title">
            <h2 id="deactivate-title">Lokale Deaktivierung</h2>
            <p>Bearbeiten Sie nur bestätigte Befunde. Die Aktion löscht keine AD- oder Auditdaten.</p>
            @foreach (var finding in _overview.Findings.Where(finding => !finding.IsResolved))
            {
                <div class="card mb-2">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span><strong>@finding.DisplayName</strong> – @finding.Reason</span>
                        <button class="btn btn-outline-danger" @onclick="() => _pending = finding"><i class="bi bi-slash-circle" aria-hidden="true"></i> Lokal deaktivieren</button>
                    </div>
                </div>
            }
            @if (_pending is not null)
            {
                <DangerZonePanel Message="@($"{_pending.DisplayName} lokal deaktivieren?")"
                                  ConfirmLabel="Deaktivierung bestätigen" IsBusy="_saving"
                                  OnConfirm="DeactivateAsync" OnCancel="() => _pending = null" />
            }
        </section>
    }
}

@code {
    private DirectoryReconciliationOverview? _overview;
    private string? _error;
    private bool _saving;
    private ManagedDirectoryReconciliationFinding? _pending;

    private bool HasActiveRun => _overview?.Runs.Any(run => run.Status is "Queued" or "Executing") == true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _error = null; _overview = await AdministrationClient.GetDirectoryReconciliationAsync(CancellationToken.None); }
        catch { _error = "Abgleichdaten konnten nicht geladen werden."; }
    }

    private async Task StartAsync()
    {
        _saving = true;
        try { _error = null; await AdministrationClient.StartDirectoryReconciliationAsync(CancellationToken.None); await LoadAsync(); }
        catch { _error = "Der Abgleich konnte nicht gestartet werden. Möglicherweise läuft bereits einer."; }
        finally { _saving = false; }
    }

    private async Task DeactivateAsync()
    {
        if (_pending is null) return;
        _saving = true;
        try { _error = null; await AdministrationClient.DeactivateDirectoryReconciliationFindingAsync(_pending, CancellationToken.None); _pending = null; await LoadAsync(); }
        catch { _error = "Die lokale Deaktivierung konnte nicht ausgeführt werden. Der Befund wurde möglicherweise bereits bearbeitet."; }
        finally { _saving = false; }
    }

    private static StatusBadge.BadgeVariant RunStatusVariant(string status) => status switch
    {
        "Succeeded" => StatusBadge.BadgeVariant.Success,
        "Failed" => StatusBadge.BadgeVariant.Danger,
        "Queued" or "Executing" => StatusBadge.BadgeVariant.Warning,
        _ => StatusBadge.BadgeVariant.Neutral
    };
}

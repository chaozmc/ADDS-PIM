@page "/admin/entitlements"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminEntitlements> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject ILogger<AdminEntitlements> Logger

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["HeroTitle"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
@if (_success is not null)
{
    <p class="submission-result succeeded" role="status">@_success</p>
}

@if (_groups is null || _entitlements is null || _subjects is null)
{
    <LoadingIndicator Message="@Localizer["LoadingMessage"]" />
}
else
{
    <section class="d-flex justify-content-between align-items-center mb-4" aria-label="@Localizer["ActionsSectionAriaLabel"]">
        <div>
            <h2 class="h4 mb-1">@Localizer["ExistingEntitlementsTitle"]</h2>
            <p class="text-muted mb-0">@Localizer["ExistingEntitlementsDescription"]</p>
        </div>
        <button class="btn btn-primary" @onclick="OpenCreateDialogAsync" disabled="@(_subjects.Count == 0)"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["CreateEntitlementButton"]</button>
    </section>

    @if (_subjects.Count == 0)
    {
        <p class="submission-result failed">@((MarkupString)Localizer["NoActiveSubjectMessage"].Value)</p>
    }

    <section aria-labelledby="list-title">
        <h2 id="list-title" class="visually-hidden">@Localizer["ActiveEntitlementsSectionTitle"]</h2>
        @{
            var activeEntitlements = _entitlements.Where(entitlement => entitlement.IsActive).ToArray();
        }
        @if (activeEntitlements.Length == 0)
        {
            <EmptyState Icon="bi-person-badge" Title="@Localizer["EmptyStateTitle"]" Description="@Localizer["EmptyStateDescription"]" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>@Localizer["PersonHeader"]</th><th>@Localizer["TargetAccountHeader"]</th><th>@Localizer["TargetGroupHeader"]</th><th>@Localizer["ValidityHeader"]</th><th>@Localizer["StatusHeader"]</th><th>@Localizer["ActionsHeader"]</th></tr></thead>
                    <tbody>
                        @foreach (var entitlement in activeEntitlements)
                        {
                            <tr>
                                <td>@entitlement.PersonDisplayName</td>
                                <td>@entitlement.TargetAccountDisplayName</td>
                                <td>@entitlement.TargetGroupDisplayName</td>
                                <td>@entitlement.ValidFromUtc.ToLocalTime().ToString("g") - @(entitlement.ValidUntilUtc?.ToLocalTime().ToString("g") ?? Localizer["OpenEndedValidity"])</td>
                                <td>
                                    @if (IsExpired(entitlement))
                                    {
                                        <StatusBadge Text="@Localizer["StatusExpired"]" Variant="StatusBadge.BadgeVariant.Warning" />
                                    }
                                    else
                                    {
                                        <StatusBadge Text="@Localizer["StatusActive"]" Variant="StatusBadge.BadgeVariant.Success" />
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" @onclick="() => OpenValidityDialogAsync(entitlement)"><i class="bi bi-calendar-event" aria-hidden="true"></i> @Localizer["ChangeValidityButton"]</button>
                                        <button class="btn btn-outline-danger" @onclick="() => _pending = entitlement"><i class="bi bi-slash-circle" aria-hidden="true"></i> @Localizer["DeactivateButton"]</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_pending is not null)
        {
            <DangerZonePanel Message="@Localizer["DeactivateConfirmMessage", _pending.TargetAccountDisplayName].Value"
                              ConfirmLabel="@Localizer["ConfirmDeactivateLabel"]" IsBusy="_saving"
                              OnConfirm="DeactivateAsync" OnCancel="() => _pending = null" />
        }
    </section>
}

<ConfirmDialog @ref="_createDialog" Title="@Localizer["CreateEntitlementButton"]" OnClosed="CloseCreateDialog">
    @if (_dialogError is not null)
    {
        <p class="alert alert-danger" role="alert">@_dialogError</p>
    }
    <p>@Localizer["DialogIntro"]</p>
    <div class="mb-3">
        <label for="entitlement-person" class="form-label">@Localizer["PersonLabel"]</label>
        <select id="entitlement-person" class="form-select" @bind="SelectedPersonId">
            <option value="">@Localizer["PersonPlaceholder"]</option>
            @foreach (var person in AvailablePersons)
            {
                <option value="@person.PersonId">@person.PersonDisplayName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label for="entitlement-target-account" class="form-label">@Localizer["TargetAccountLabel"]</label>
        <select id="entitlement-target-account" class="form-select" @bind="_selectedTargetAccountId" disabled="@string.IsNullOrWhiteSpace(_selectedPersonId)">
            <option value="">@Localizer["TargetAccountPlaceholder"]</option>
            @foreach (var subject in SelectedPersonSubjects)
            {
                <option value="@subject.TargetAccountId">@subject.TargetAccountDisplayName</option>
            }
        </select>
        <div class="form-text">@Localizer["TargetAccountHelpText"]</div>
    </div>
    <div class="mb-3">
        <label for="entitlement-target-group" class="form-label">@Localizer["TargetGroupLabel"]</label>
        <select id="entitlement-target-group" class="form-select" @bind="_selectedGroupId">
            <option value="">@Localizer["TargetGroupPlaceholder"]</option>
            @foreach (var group in (_groups ?? []).Where(group => group.IsEnabledForRequests && group.PolicyIsActive))
            {
                <option value="@group.TargetGroupId">@group.DomainQualifiedName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label for="entitlement-valid-until" class="form-label">@Localizer["ValidUntilLabel"]</label>
        <div class="input-group">
            <InputDate id="entitlement-valid-until" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_validUntilLocal" />
            <button class="btn btn-outline-secondary" type="button" @onclick="() => _validUntilLocal = null" title="@Localizer["ClearDateTitle"]"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="form-text">@Localizer["ValidUntilHelpText"]</div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
        <button class="btn btn-primary" @onclick="CreateAsync" disabled="@(_saving || !CanCreate)">@Localizer["CreateEntitlementButton"]</button>
    </div>
</ConfirmDialog>

<ConfirmDialog @ref="_validityDialog" Title="@Localizer["ChangeValidityButton"]" OnClosed="() => { _validityTarget = null; _validityError = null; }">
    @if (_validityTarget is not null)
    {
        @if (_validityError is not null)
        {
            <p class="alert alert-danger" role="alert">@_validityError</p>
        }
        <p><strong>@_validityTarget.PersonDisplayName</strong> → @_validityTarget.TargetGroupDisplayName (@_validityTarget.TargetAccountDisplayName)</p>
        <div class="mb-3">
            <label for="entitlement-edit-valid-until" class="form-label">@Localizer["ValidUntilEditLabel"]</label>
            <div class="input-group">
                <InputDate id="entitlement-edit-valid-until" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="_validityUntilLocal" />
                <button class="btn btn-outline-secondary" type="button" @onclick="() => _validityUntilLocal = null" title="@Localizer["NoExpiryTitle"]"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="form-text">@Localizer["ValidityHelpText"]</div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
            <button class="btn btn-primary" @onclick="SaveValidityAsync" disabled="@_saving">@SharedLocalizer["SaveButton"]</button>
        </div>
    }
</ConfirmDialog>

@code {
    private IReadOnlyList<ManagedTargetGroup>? _groups;
    private IReadOnlyList<ManagedDirectEntitlement>? _entitlements;
    private IReadOnlyList<EntitlementSubject>? _subjects;
    private string? _error;
    private string? _dialogError;
    private string? _success;
    private bool _saving;
    private string _selectedPersonId = string.Empty;
    private string _selectedTargetAccountId = string.Empty;
    private string _selectedGroupId = string.Empty;
    private DateTime? _validUntilLocal;
    private ManagedDirectEntitlement? _pending;
    private ConfirmDialog? _createDialog;
    private ConfirmDialog? _validityDialog;
    private ManagedDirectEntitlement? _validityTarget;
    private DateTime? _validityUntilLocal;
    private string? _validityError;

    private string SelectedPersonId { get => _selectedPersonId; set { if (_selectedPersonId != value) { _selectedPersonId = value; _selectedTargetAccountId = string.Empty; } } }
    private IEnumerable<EntitlementSubject> AvailablePersons => (_subjects ?? []).GroupBy(subject => subject.PersonId).Select(group => group.First()).OrderBy(subject => subject.PersonDisplayName);
    private IEnumerable<EntitlementSubject> SelectedPersonSubjects => Guid.TryParse(_selectedPersonId, out var personId) ? (_subjects ?? []).Where(subject => subject.PersonId == personId).OrderBy(subject => subject.TargetAccountDisplayName) : [];
    private bool CanCreate => Guid.TryParse(_selectedPersonId, out _) && Guid.TryParse(_selectedTargetAccountId, out _) && Guid.TryParse(_selectedGroupId, out _);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _groups = await AdministrationClient.GetTargetGroupsAsync(CancellationToken.None);
            _entitlements = await AdministrationClient.GetEntitlementsAsync(CancellationToken.None);
            _subjects = await AdministrationClient.GetEligibleEntitlementSubjectsAsync(CancellationToken.None);
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load entitlements page data."); _error = Localizer["LoadError"]; }
    }

    private async Task OpenCreateDialogAsync()
    {
        _error = null; _dialogError = null; _success = null; _selectedPersonId = _selectedTargetAccountId = _selectedGroupId = string.Empty; _validUntilLocal = null;
        StateHasChanged();
        await _createDialog!.ShowAsync();
    }

    private void CloseCreateDialog() { }

    private async Task CreateAsync()
    {
        var subject = SelectedPersonSubjects.SingleOrDefault(subject => subject.TargetAccountId.ToString("D") == _selectedTargetAccountId);
        if (subject is null || !Guid.TryParse(_selectedGroupId, out var groupId)) { _dialogError = Localizer["CreateValidationError"]; return; }
        var until = _validUntilLocal is null ? (DateTimeOffset?)null : new DateTimeOffset(DateTime.SpecifyKind(_validUntilLocal.Value, DateTimeKind.Unspecified), TimeZoneInfo.Local.GetUtcOffset(_validUntilLocal.Value)).ToUniversalTime();
        _saving = true;
        try
        {
            _dialogError = null;
            await AdministrationClient.CreateDirectEntitlementAsync(subject.PersonId, subject.TargetAccountId, groupId, DateTimeOffset.UtcNow, until, CancellationToken.None);
            await _createDialog!.HideAsync();
            _success = Localizer["CreateSuccess"];
            await LoadAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict) { _dialogError = Localizer["CreateConflictError"]; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to create direct entitlement for PersonId {PersonId} TargetGroupId {TargetGroupId}.", subject.PersonId, groupId); _dialogError = Localizer["CreateGenericError"]; }
        finally { _saving = false; }
    }

    private static bool IsExpired(ManagedDirectEntitlement entitlement) => entitlement.ValidUntilUtc is not null && entitlement.ValidUntilUtc <= DateTimeOffset.UtcNow;

    private async Task OpenValidityDialogAsync(ManagedDirectEntitlement entitlement)
    {
        _validityTarget = entitlement; _validityError = null;
        _validityUntilLocal = entitlement.ValidUntilUtc?.ToLocalTime().DateTime;
        StateHasChanged();
        await _validityDialog!.ShowAsync();
    }

    private async Task SaveValidityAsync()
    {
        if (_validityTarget is null) return;
        var until = _validityUntilLocal is null ? (DateTimeOffset?)null : new DateTimeOffset(DateTime.SpecifyKind(_validityUntilLocal.Value, DateTimeKind.Unspecified), TimeZoneInfo.Local.GetUtcOffset(_validityUntilLocal.Value)).ToUniversalTime();
        _saving = true;
        try
        {
            _validityError = null;
            await AdministrationClient.UpdateDirectEntitlementValidityAsync(_validityTarget, until, CancellationToken.None);
            await _validityDialog!.HideAsync();
            _success = Localizer["ValiditySuccess"];
            await LoadAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict) { _validityError = Localizer["ValidityConflictError"]; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity) { _validityError = Localizer["ValidityUnprocessableError"]; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to update direct entitlement validity for EntitlementId {EntitlementId}.", _validityTarget.EntitlementId); _validityError = Localizer["ValidityGenericError"]; }
        finally { _saving = false; }
    }

    private async Task DeactivateAsync()
    {
        var pending = _pending;
        if (pending is null) return;
        _saving = true;
        try { await AdministrationClient.DeactivateDirectEntitlementAsync(pending, CancellationToken.None); _pending = null; _success = Localizer["DeactivateSuccess"]; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to deactivate direct entitlement EntitlementId {EntitlementId}.", pending.EntitlementId); _error = Localizer["DeactivateGenericError"]; }
        finally { _saving = false; }
    }
}

@page "/admin/groups"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminGroups> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject ILogger<AdminGroups> Logger

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["HeroTitle"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_groups is null)
{
    <LoadingIndicator Message="@Localizer["LoadingGroups"]" />
}
else
{
    var activeGroups = _groups.Where(group => group.IsEnabledForRequests && group.PolicyIsActive).ToArray();
    var inactiveGroups = _groups.Where(group => !group.IsEnabledForRequests || !group.PolicyIsActive).ToArray();

    <section aria-labelledby="groups-title">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="groups-title">@Localizer["TargetGroupsTitle"]</h2>
            <button class="btn btn-primary" @onclick="OpenCreateDialogAsync"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["RegisterGroupButton"]</button>
        </div>

        @if (activeGroups.Length == 0)
        {
            <EmptyState Icon="bi-diagram-3" Title="@Localizer["EmptyStateTitle"]" Description="@Localizer["EmptyStateDescription"]" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>@Localizer["TableHeaderGroup"]</th><th>@Localizer["TableHeaderTtl"]</th><th>@Localizer["TableHeaderMfa"]</th><th>@Localizer["TableHeaderTicket"]</th><th>@Localizer["TableHeaderApproval"]</th><th>@Localizer["TableHeaderApprovers"]</th><th>@Localizer["TableHeaderActions"]</th></tr></thead>
                    <tbody>
                        @foreach (var group in activeGroups)
                        {
                            <tr>
                                <td>@group.DomainQualifiedName</td>
                                <td>@Hours(group.MinimumTtlSeconds)–@Hours(group.MaximumTtlSeconds), @Localizer["StepPrefix"] @Hours(group.AllowedTtlStepSeconds)</td>
                                <td>@SecondFactor(group)</td>
                                <td>@(group.RequiresTicket ? Localizer["YesText"] : Localizer["NoText"])</td>
                                <td>@(group.RequiresApproval ? Localizer["YesText"] : Localizer["NoText"])</td>
                                <td><button class="btn btn-link p-0" @onclick="() => OpenApproversDialogAsync(group)">@Localizer["ManageButton"]</button></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-secondary" @onclick="() => OpenEditDialogAsync(group)"><i class="bi bi-pencil-square" aria-hidden="true"></i> @Localizer["EditButton"]</button>
                                        <button class="btn btn-outline-danger" @onclick="() => _pendingDeactivation = group"><i class="bi bi-slash-circle" aria-hidden="true"></i> @Localizer["DeactivateButton"]</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_pendingDeactivation is not null)
        {
            <DangerZonePanel Message="@Localizer["DeactivateConfirmMessage", _pendingDeactivation.DomainQualifiedName].Value"
                              ConfirmLabel="@Localizer["ConfirmDeactivateLabel"]" IsBusy="_saving"
                              OnConfirm="DeactivateAsync" OnCancel="() => _pendingDeactivation = null" />
        }

        @if (inactiveGroups.Length > 0)
        {
            <div class="mt-4">
                <button class="btn btn-link ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#inactive-groups">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i> @Localizer["InactiveGroupsToggle", inactiveGroups.Length]
                </button>
                <div class="collapse" id="inactive-groups">
                    <table class="table mt-2">
                        <tbody>
                            @foreach (var group in inactiveGroups)
                            {
                                <tr>
                                    <td>@group.DomainQualifiedName</td>
                                    <td class="text-end"><button class="btn btn-sm btn-primary" @onclick="() => _pendingReactivation = group"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @Localizer["ReactivateButton"]</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_pendingReactivation is not null)
        {
            <div class="alert alert-primary d-flex justify-content-between align-items-center mt-3">
                <span>@Localizer["ReactivateConfirmMessage", _pendingReactivation.DomainQualifiedName]</span>
                <span class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="ReactivateAsync" disabled="@_saving">@Localizer["ReactivateButton"]</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _pendingReactivation = null" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
                </span>
            </div>
        }
    </section>
}

<ConfirmDialog @ref="_createDialog" Title="@Localizer["RegisterGroupButton"]" OnClosed="CloseCreateDialog">
    @if (_newGroup is not null)
    {
        <EditForm Model="_newGroup" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <p>@Localizer["SearchIntro"]</p>
            <div class="input-group">
                <InputText class="form-control" @bind-Value="_searchTerm" placeholder="@Localizer["SearchPlaceholder"]" />
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchAsync" disabled="@_saving">@Localizer["SearchButton"]</button>
            </div>
            @if (_searchError is not null)
            {
                <p class="text-danger mt-2 mb-0" role="alert">@_searchError</p>
            }
            @if (_searchResults is not null && _searchResults.Count > 0)
            {
                <div class="mt-3">
                    <label>@Localizer["SelectGroupLabel"]</label>
                    <InputSelect class="form-select" @bind-Value="_newGroup.ObjectGuid">
                        <option value="">@Localizer["PleaseSelectOption"]</option>
                        @foreach (var group in _searchResults)
                        {
                            <option value="@group.ObjectGuid">@group.DomainQualifiedName (@group.DisplayName)</option>
                        }
                    </InputSelect>
                </div>
            }
            <hr />
            <div class="row g-3">
                <div class="col"><label>@Localizer["MinimumHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_newGroup.MinimumHours" /></div>
                <div class="col"><label>@Localizer["MaximumHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_newGroup.MaximumHours" /></div>
                <div class="col"><label>@Localizer["DefaultHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_newGroup.DefaultHours" /></div>
                <div class="col"><label>@Localizer["StepHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_newGroup.StepHours" /></div>
            </div>
            <ValidationSummary />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
                <button class="btn btn-primary" type="submit" disabled="@_saving">@Localizer["RegisterSubmitButton"]</button>
            </div>
        </EditForm>
    }
</ConfirmDialog>

<ConfirmDialog @ref="_editDialog" Title="@Localizer["PolicyDialogTitle", _editor?.DomainQualifiedName ?? string.Empty].Value" OnClosed="() => { _editor = null; _editorError = null; }">
    @if (_editor is not null)
    {
        <EditForm Model="_editor" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (_editorError is not null)
            {
                <p class="alert alert-danger" role="alert">@_editorError</p>
            }
            <div class="row g-3">
                <div class="col"><label>@Localizer["MinimumHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_editor.MinimumHours" /></div>
                <div class="col"><label>@Localizer["MaximumHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_editor.MaximumHours" /></div>
                <div class="col"><label>@Localizer["DefaultHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_editor.DefaultHours" /></div>
                <div class="col"><label>@Localizer["StepHoursLabel"]</label><InputNumber class="form-control" @bind-Value="_editor.StepHours" /></div>
                <div class="col-12"><label>@Localizer["SecondFactorsLabel"]</label>
                    <InputSelect class="form-select" @bind-Value="_editor.AllowedSecondFactorTypes">
                        <option value="0">@Localizer["SecondFactorNone"]</option>
                        <option value="1">FIDO2</option>
                        <option value="2">TOTP</option>
                        <option value="3">@Localizer["SecondFactorTotpOrFido2"]</option>
                    </InputSelect>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-3">
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.RequiresSecondFactor" @bind-Value:after="EnsureSecondFactorTypeSelected" /><label class="form-check-label">@Localizer["MfaRequiredLabel"]</label></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.RequiresTicket" /><label class="form-check-label">@Localizer["TicketRequiredLabel"]</label></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.RequiresApproval" /><label class="form-check-label">@Localizer["ApprovalRequiredLabel"]</label></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.IsEnabledForRequests" /><label class="form-check-label">@Localizer["RequestsEnabledLabel"]</label></div>
            </div>
            @if (_editor.RequiresSecondFactor && _editor.AllowedSecondFactorTypes == 0)
            {
                <div class="form-text text-danger">@Localizer["SecondFactorWarning"]</div>
            }
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
                <button class="btn btn-primary" type="submit" disabled="@(_saving || (_editor.RequiresSecondFactor && _editor.AllowedSecondFactorTypes == 0))">@SharedLocalizer["SaveButton"]</button>
            </div>
        </EditForm>
    }
</ConfirmDialog>

<ConfirmDialog @ref="_approversDialog" Title="@Localizer["ApproversDialogTitle", _approversGroup?.DomainQualifiedName ?? string.Empty].Value" OnClosed="() => { _approversGroup = null; _approvers = null; _approverError = null; }">
    @if (_approversGroup is not null)
    {
        @if (_approverError is not null)
        {
            <p class="alert alert-danger" role="alert">@_approverError</p>
        }
        @if (_approvers is null)
        {
            <LoadingIndicator Message="@Localizer["LoadingApprovers"]" />
        }
        else
        {
            var activeApprovers = _approvers.Where(approver => approver.IsActive).ToArray();
            @if (activeApprovers.Length == 0)
            {
                <p class="text-muted">@Localizer["NoApproversMessage"]</p>
            }
            else
            {
                <table class="table table-sm">
                    <tbody>
                        @foreach (var approver in activeApprovers)
                        {
                            <tr>
                                <td>@approver.PersonDisplayName</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateApproverAsync(approver)" disabled="@_savingApprover">@Localizer["RemoveButton"]</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <hr />
            <p>@Localizer["AddApproverIntro"]</p>
            <div class="input-group">
                <select class="form-select" @bind="_selectedApproverPersonId">
                    <option value="">@Localizer["PleaseSelectOption"]</option>
                    @if (_persons is not null)
                    {
                        @foreach (var person in _persons.Where(p => p.IsActive))
                        {
                            <option value="@person.PersonId">@person.DisplayName</option>
                        }
                    }
                </select>
                <button class="btn btn-primary" type="button" @onclick="AddApproverAsync" disabled="@(_savingApprover || string.IsNullOrEmpty(_selectedApproverPersonId))">@Localizer["AddButton"]</button>
            </div>
        }
    }
</ConfirmDialog>

@code {
    private IReadOnlyList<ManagedTargetGroup>? _groups;
    private string? _error;
    private string? _searchError;
    private bool _saving;
    private NewGroup? _newGroup;
    private Editor? _editor;
    private string? _editorError;
    private ManagedTargetGroup? _pendingDeactivation;
    private ManagedTargetGroup? _pendingReactivation;
    private string _searchTerm = string.Empty;
    private IReadOnlyList<DirectoryGroupSearchResult>? _searchResults;
    private ConfirmDialog? _createDialog;
    private ConfirmDialog? _editDialog;
    private ConfirmDialog? _approversDialog;
    private ManagedTargetGroup? _approversGroup;
    private IReadOnlyList<ManagedGroupApprover>? _approvers;
    private IReadOnlyList<ManagedPerson>? _persons;
    private string _selectedApproverPersonId = string.Empty;
    private bool _savingApprover;
    private string? _approverError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _error = null; _groups = await AdministrationClient.GetTargetGroupsAsync(CancellationToken.None); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load target groups."); _error = Localizer["LoadGroupsError"]; }
    }

    private async Task OpenApproversDialogAsync(ManagedTargetGroup group)
    {
        _approversGroup = group; _approvers = null; _approverError = null; _selectedApproverPersonId = string.Empty;
        StateHasChanged();
        await _approversDialog!.ShowAsync();
        try
        {
            _persons ??= await AdministrationClient.GetPersonsAsync(CancellationToken.None);
            _approvers = await AdministrationClient.GetGroupApproversAsync(group.TargetGroupId, CancellationToken.None);
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load approvers for TargetGroupId {TargetGroupId}.", group.TargetGroupId); _approverError = Localizer["LoadApproversError"]; }
    }

    private async Task AddApproverAsync()
    {
        if (_approversGroup is null || !Guid.TryParse(_selectedApproverPersonId, out var personId)) return;
        _savingApprover = true;
        try
        {
            _approverError = null;
            await AdministrationClient.AddGroupApproverAsync(_approversGroup.TargetGroupId, personId, CancellationToken.None);
            _approvers = await AdministrationClient.GetGroupApproversAsync(_approversGroup.TargetGroupId, CancellationToken.None);
            _selectedApproverPersonId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity) { _approverError = Localizer["AddApproverUnprocessableError"]; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict) { _approverError = Localizer["AddApproverConflictError"]; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to add group approver PersonId {PersonId} to TargetGroupId {TargetGroupId}.", personId, _approversGroup.TargetGroupId); _approverError = Localizer["AddApproverGenericError"]; }
        finally { _savingApprover = false; }
    }

    private async Task DeactivateApproverAsync(ManagedGroupApprover approver)
    {
        if (_approversGroup is null) return;
        _savingApprover = true;
        try
        {
            _approverError = null;
            await AdministrationClient.DeactivateGroupApproverAsync(_approversGroup.TargetGroupId, approver, CancellationToken.None);
            _approvers = await AdministrationClient.GetGroupApproversAsync(_approversGroup.TargetGroupId, CancellationToken.None);
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to deactivate group approver {GroupApproverId}.", approver.GroupApproverId); _approverError = Localizer["RemoveApproverError"]; }
        finally { _savingApprover = false; }
    }

    private static string Hours(long seconds) => $"{seconds / 3600m:0.##} h";
    private string SecondFactor(ManagedTargetGroup group) => !group.RequiresSecondFactor ? Localizer["NoText"] : group.AllowedSecondFactorTypes switch { 1 => "FIDO2", 2 => "TOTP", 3 => Localizer["SecondFactorTotpOrFido2"], _ => Localizer["SecondFactorInvalid"] };

    private void EnsureSecondFactorTypeSelected()
    {
        if (_editor is not null && _editor.RequiresSecondFactor && _editor.AllowedSecondFactorTypes == 0)
        {
            _editor.AllowedSecondFactorTypes = 3;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        _newGroup = new(); _searchTerm = string.Empty; _searchResults = null; _searchError = null;
        StateHasChanged();
        await _createDialog!.ShowAsync();
    }

    private void CloseCreateDialog() { _newGroup = null; _searchResults = null; _searchError = null; }

    private async Task OpenEditDialogAsync(ManagedTargetGroup group)
    {
        _editor = new(group); _editorError = null;
        StateHasChanged();
        await _editDialog!.ShowAsync();
    }

    private async Task SearchAsync()
    {
        if (_searchTerm.Trim().Length < 2) { _searchError = Localizer["SearchMinLengthError"]; return; }
        _saving = true;
        try
        {
            _searchError = null;
            _searchResults = await AdministrationClient.SearchDirectoryGroupsAsync(_searchTerm, CancellationToken.None);
            if (_searchResults.Count == 0) _searchError = Localizer["SearchNoResultsError"];
        }
        catch (Exception ex) { Logger.LogError(ex, "Directory group search failed for term {SearchTerm}.", _searchTerm); _searchError = Localizer["SearchFailedError"]; }
        finally { _saving = false; }
    }

    private async Task CreateAsync()
    {
        if (_newGroup is null || !Guid.TryParse(_newGroup.ObjectGuid, out var id)) { _searchError = Localizer["CreateSelectGroupError"]; return; }
        _saving = true;
        try
        {
            await AdministrationClient.CreateTargetGroupAsync(id, _newGroup.ToSeconds(_newGroup.MinimumHours), _newGroup.ToSeconds(_newGroup.MaximumHours), _newGroup.ToSeconds(_newGroup.DefaultHours), _newGroup.ToSeconds(_newGroup.StepHours), false, 0, false, false, CancellationToken.None);
            await _createDialog!.HideAsync();
            await LoadAsync();
        }
        catch (Exception ex) { Logger.LogError(ex, "Failed to create target group for ObjectGuid {ObjectGuid}.", id); _searchError = Localizer["CreateGenericError"]; }
        finally { _saving = false; }
    }

    private async Task SaveAsync()
    {
        if (_editor is null) return;
        _saving = true;
        try
        {
            _editorError = null;
            await AdministrationClient.UpdateTargetGroupPolicyAsync(_editor.ToContract(), CancellationToken.None);
            await _editDialog!.HideAsync();
            await LoadAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict) { _editorError = Localizer["SaveConflictError"]; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity) { _editorError = Localizer["SaveUnprocessableError"]; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { _editorError = Localizer["SaveNotFoundError"]; }
        catch (Exception ex) { Logger.LogError(ex, "Failed to save target group policy for TargetGroupId {TargetGroupId}.", _editor.Source.TargetGroupId); _editorError = Localizer["SaveGenericError"]; }
        finally { _saving = false; }
    }

    private async Task DeactivateAsync()
    {
        var group = _pendingDeactivation;
        if (group is null) return;
        _saving = true;
        try { await AdministrationClient.DeactivateTargetGroupAsync(group, CancellationToken.None); _pendingDeactivation = null; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to deactivate TargetGroupId {TargetGroupId}.", group.TargetGroupId); _error = Localizer["DeactivateGenericError"]; }
        finally { _saving = false; }
    }

    private async Task ReactivateAsync()
    {
        var group = _pendingReactivation;
        if (group is null) return;
        _saving = true;
        try { await AdministrationClient.ReactivateTargetGroupAsync(group, CancellationToken.None); _pendingReactivation = null; await LoadAsync(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to reactivate TargetGroupId {TargetGroupId}.", group.TargetGroupId); _error = Localizer["ReactivateGenericError"]; }
        finally { _saving = false; }
    }

    private sealed class NewGroup
    {
        [System.ComponentModel.DataAnnotations.Required] public string ObjectGuid { get; set; } = string.Empty;
        public decimal MinimumHours { get; set; } = 1;
        public decimal MaximumHours { get; set; } = 8;
        public decimal DefaultHours { get; set; } = 1;
        public decimal StepHours { get; set; } = .5m;
        public long ToSeconds(decimal hours) => checked((long)(hours * 3600m));
    }

    private sealed class Editor
    {
        public Editor(ManagedTargetGroup group)
        {
            Source = group; DomainQualifiedName = group.DomainQualifiedName;
            MinimumHours = group.MinimumTtlSeconds / 3600m; MaximumHours = group.MaximumTtlSeconds / 3600m;
            DefaultHours = group.DefaultTtlSeconds / 3600m; StepHours = group.AllowedTtlStepSeconds / 3600m;
            RequiresSecondFactor = group.RequiresSecondFactor; AllowedSecondFactorTypes = group.AllowedSecondFactorTypes;
            RequiresTicket = group.RequiresTicket; RequiresApproval = group.RequiresApproval; IsEnabledForRequests = group.IsEnabledForRequests;
        }
        public ManagedTargetGroup Source { get; }
        public string DomainQualifiedName { get; }
        public decimal MinimumHours { get; set; }
        public decimal MaximumHours { get; set; }
        public decimal DefaultHours { get; set; }
        public decimal StepHours { get; set; }
        public bool RequiresSecondFactor { get; set; }
        public int AllowedSecondFactorTypes { get; set; }
        public bool RequiresTicket { get; set; }
        public bool RequiresApproval { get; set; }
        public bool IsEnabledForRequests { get; set; }
        public ManagedTargetGroup ToContract() => Source with
        {
            IsEnabledForRequests = IsEnabledForRequests,
            MinimumTtlSeconds = checked((long)(MinimumHours * 3600m)),
            MaximumTtlSeconds = checked((long)(MaximumHours * 3600m)),
            DefaultTtlSeconds = checked((long)(DefaultHours * 3600m)),
            AllowedTtlStepSeconds = checked((long)(StepHours * 3600m)),
            RequiresSecondFactor = RequiresSecondFactor,
            AllowedSecondFactorTypes = AllowedSecondFactorTypes,
            RequiresTicket = RequiresTicket,
            RequiresApproval = RequiresApproval
        };
    }
}

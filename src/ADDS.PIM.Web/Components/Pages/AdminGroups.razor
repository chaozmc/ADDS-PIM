@page "/admin/groups"
@inject IAdministrationClient AdministrationClient

<PageTitle>ADDS-PIM - Gruppenverwaltung</PageTitle>

<section class="hero">
    <div>
        <h1>Gruppenverwaltung</h1>
        <p>Registrieren und verwalten Sie die über ADDS-PIM anfragbaren AD-Gruppen.</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_groups is null)
{
    <LoadingIndicator Message="Gruppen werden geladen …" />
}
else
{
    var activeGroups = _groups.Where(group => group.IsEnabledForRequests && group.PolicyIsActive).ToArray();
    var inactiveGroups = _groups.Where(group => !group.IsEnabledForRequests || !group.PolicyIsActive).ToArray();

    <section aria-labelledby="groups-title">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="groups-title">Zielgruppen</h2>
            <button class="btn btn-primary" @onclick="OpenCreateDialogAsync"><i class="bi bi-plus-lg" aria-hidden="true"></i> AD-Gruppe registrieren</button>
        </div>

        @if (activeGroups.Length == 0)
        {
            <EmptyState Icon="bi-diagram-3" Title="Keine aktiven Zielgruppen" Description="Registrieren Sie eine AD-Gruppe, um sie über ADDS-PIM anfragbar zu machen." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Gruppe</th><th>TTL</th><th>MFA</th><th>Ticket</th><th>Approval</th><th>Genehmigende</th><th>Aktionen</th></tr></thead>
                    <tbody>
                        @foreach (var group in activeGroups)
                        {
                            <tr>
                                <td>@group.DomainQualifiedName</td>
                                <td>@Hours(group.MinimumTtlSeconds)–@Hours(group.MaximumTtlSeconds), Schritt @Hours(group.AllowedTtlStepSeconds)</td>
                                <td>@SecondFactor(group)</td>
                                <td>@(group.RequiresTicket ? "Ja" : "Nein")</td>
                                <td>@(group.RequiresApproval ? "Ja" : "Nein")</td>
                                <td><button class="btn btn-link p-0" @onclick="() => OpenApproversDialogAsync(group)">Verwalten</button></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-secondary" @onclick="() => OpenEditDialogAsync(group)"><i class="bi bi-pencil-square" aria-hidden="true"></i> Bearbeiten</button>
                                        <button class="btn btn-outline-danger" @onclick="() => _pendingDeactivation = group"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deaktivieren</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_pendingDeactivation is not null)
        {
            <DangerZonePanel Message="@($"{_pendingDeactivation.DomainQualifiedName} wirklich für neue Anfragen deaktivieren? Historische Daten bleiben erhalten.")"
                              ConfirmLabel="Endgültig deaktivieren" IsBusy="_saving"
                              OnConfirm="DeactivateAsync" OnCancel="() => _pendingDeactivation = null" />
        }

        @if (inactiveGroups.Length > 0)
        {
            <div class="mt-4">
                <button class="btn btn-link ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#inactive-groups">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i> Deaktivierte Gruppen (@inactiveGroups.Length)
                </button>
                <div class="collapse" id="inactive-groups">
                    <table class="table mt-2">
                        <tbody>
                            @foreach (var group in inactiveGroups)
                            {
                                <tr>
                                    <td>@group.DomainQualifiedName</td>
                                    <td class="text-end"><button class="btn btn-sm btn-primary" @onclick="() => _pendingReactivation = group"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reaktivieren</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_pendingReactivation is not null)
        {
            <div class="alert alert-primary d-flex justify-content-between align-items-center mt-3">
                <span>@_pendingReactivation.DomainQualifiedName wieder aktivieren? Die Gruppe wird davor erneut aus AD verifiziert.</span>
                <span class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="ReactivateAsync" disabled="@_saving">Reaktivieren</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _pendingReactivation = null" disabled="@_saving">Abbrechen</button>
                </span>
            </div>
        }
    </section>
}

<ConfirmDialog @ref="_createDialog" Title="AD-Gruppe registrieren" OnClosed="CloseCreateDialog">
    @if (_newGroup is not null)
    {
        <EditForm Model="_newGroup" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <p>Suchen Sie nach Name oder sAMAccountName. Die Auswahl wird serverseitig gegen AD verifiziert.</p>
            <div class="input-group">
                <InputText class="form-control" @bind-Value="_searchTerm" placeholder="z. B. Server-Admins" />
                <button class="btn btn-outline-secondary" type="button" @onclick="SearchAsync" disabled="@_saving">Suchen</button>
            </div>
            @if (_searchError is not null)
            {
                <p class="text-danger mt-2 mb-0" role="alert">@_searchError</p>
            }
            @if (_searchResults is not null && _searchResults.Count > 0)
            {
                <div class="mt-3">
                    <label>AD-Gruppe auswählen</label>
                    <InputSelect class="form-select" @bind-Value="_newGroup.ObjectGuid">
                        <option value="">Bitte wählen</option>
                        @foreach (var group in _searchResults)
                        {
                            <option value="@group.ObjectGuid">@group.DomainQualifiedName (@group.DisplayName)</option>
                        }
                    </InputSelect>
                </div>
            }
            <hr />
            <div class="row g-3">
                <div class="col"><label>Minimum (h)</label><InputNumber class="form-control" @bind-Value="_newGroup.MinimumHours" /></div>
                <div class="col"><label>Maximum (h)</label><InputNumber class="form-control" @bind-Value="_newGroup.MaximumHours" /></div>
                <div class="col"><label>Standard (h)</label><InputNumber class="form-control" @bind-Value="_newGroup.DefaultHours" /></div>
                <div class="col"><label>Schritt (h)</label><InputNumber class="form-control" @bind-Value="_newGroup.StepHours" /></div>
            </div>
            <ValidationSummary />
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">Abbrechen</button>
                <button class="btn btn-primary" type="submit" disabled="@_saving">Registrieren</button>
            </div>
        </EditForm>
    }
</ConfirmDialog>

<ConfirmDialog @ref="_editDialog" Title="@($"Policy: {_editor?.DomainQualifiedName}")" OnClosed="() => { _editor = null; _editorError = null; }">
    @if (_editor is not null)
    {
        <EditForm Model="_editor" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            @if (_editorError is not null)
            {
                <p class="alert alert-danger" role="alert">@_editorError</p>
            }
            <div class="row g-3">
                <div class="col"><label>Minimum (h)</label><InputNumber class="form-control" @bind-Value="_editor.MinimumHours" /></div>
                <div class="col"><label>Maximum (h)</label><InputNumber class="form-control" @bind-Value="_editor.MaximumHours" /></div>
                <div class="col"><label>Standard (h)</label><InputNumber class="form-control" @bind-Value="_editor.DefaultHours" /></div>
                <div class="col"><label>Schritt (h)</label><InputNumber class="form-control" @bind-Value="_editor.StepHours" /></div>
                <div class="col-12"><label>Zweite Faktoren</label>
                    <InputSelect class="form-select" @bind-Value="_editor.AllowedSecondFactorTypes">
                        <option value="0">Keine</option>
                        <option value="1">FIDO2</option>
                        <option value="2">TOTP</option>
                        <option value="3">TOTP oder FIDO2</option>
                    </InputSelect>
                </div>
            </div>
            <div class="mt-3 d-flex flex-wrap gap-3">
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.RequiresSecondFactor" @bind-Value:after="EnsureSecondFactorTypeSelected" /><label class="form-check-label">MFA erforderlich</label></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.RequiresTicket" /><label class="form-check-label">Ticket erforderlich</label></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.RequiresApproval" /><label class="form-check-label">Approval erforderlich</label></div>
                <div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="_editor.IsEnabledForRequests" /><label class="form-check-label">Anfragen aktiviert</label></div>
            </div>
            @if (_editor.RequiresSecondFactor && _editor.AllowedSecondFactorTypes == 0)
            {
                <div class="form-text text-danger">Bei aktivierter MFA-Pflicht muss unter "Zweite Faktoren" TOTP, FIDO2 oder beides ausgewählt sein.</div>
            }
            <div class="d-flex justify-content-end gap-2 mt-3">
                <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">Abbrechen</button>
                <button class="btn btn-primary" type="submit" disabled="@(_saving || (_editor.RequiresSecondFactor && _editor.AllowedSecondFactorTypes == 0))">Speichern</button>
            </div>
        </EditForm>
    }
</ConfirmDialog>

<ConfirmDialog @ref="_approversDialog" Title="@($"Genehmigende: {_approversGroup?.DomainQualifiedName}")" OnClosed="() => { _approversGroup = null; _approvers = null; _approverError = null; }">
    @if (_approversGroup is not null)
    {
        @if (_approverError is not null)
        {
            <p class="alert alert-danger" role="alert">@_approverError</p>
        }
        @if (_approvers is null)
        {
            <LoadingIndicator Message="Genehmigende werden geladen …" />
        }
        else
        {
            var activeApprovers = _approvers.Where(approver => approver.IsActive).ToArray();
            @if (activeApprovers.Length == 0)
            {
                <p class="text-muted">Dieser Gruppe ist derzeit kein aktiver Approver zugeordnet. Anfragen mit Genehmigungspflicht bleiben ohne Zuordnung dauerhaft wartend.</p>
            }
            else
            {
                <table class="table table-sm">
                    <tbody>
                        @foreach (var approver in activeApprovers)
                        {
                            <tr>
                                <td>@approver.PersonDisplayName</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => DeactivateApproverAsync(approver)" disabled="@_savingApprover">Entfernen</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <hr />
            <p>Person als Approver hinzufügen (die Person benötigt bereits ein aktives Anmeldekonto mit Approver-Recht):</p>
            <div class="input-group">
                <select class="form-select" @bind="_selectedApproverPersonId">
                    <option value="">Bitte wählen</option>
                    @if (_persons is not null)
                    {
                        @foreach (var person in _persons.Where(p => p.IsActive))
                        {
                            <option value="@person.PersonId">@person.DisplayName</option>
                        }
                    }
                </select>
                <button class="btn btn-primary" type="button" @onclick="AddApproverAsync" disabled="@(_savingApprover || string.IsNullOrEmpty(_selectedApproverPersonId))">Hinzufügen</button>
            </div>
        }
    }
</ConfirmDialog>

@code {
    private IReadOnlyList<ManagedTargetGroup>? _groups;
    private string? _error;
    private string? _searchError;
    private bool _saving;
    private NewGroup? _newGroup;
    private Editor? _editor;
    private string? _editorError;
    private ManagedTargetGroup? _pendingDeactivation;
    private ManagedTargetGroup? _pendingReactivation;
    private string _searchTerm = string.Empty;
    private IReadOnlyList<DirectoryGroupSearchResult>? _searchResults;
    private ConfirmDialog? _createDialog;
    private ConfirmDialog? _editDialog;
    private ConfirmDialog? _approversDialog;
    private ManagedTargetGroup? _approversGroup;
    private IReadOnlyList<ManagedGroupApprover>? _approvers;
    private IReadOnlyList<ManagedPerson>? _persons;
    private string _selectedApproverPersonId = string.Empty;
    private bool _savingApprover;
    private string? _approverError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _error = null; _groups = await AdministrationClient.GetTargetGroupsAsync(CancellationToken.None); }
        catch { _error = "Gruppen konnten nicht geladen werden. Prüfen Sie Berechtigung und Serverprotokolle."; }
    }

    private async Task OpenApproversDialogAsync(ManagedTargetGroup group)
    {
        _approversGroup = group; _approvers = null; _approverError = null; _selectedApproverPersonId = string.Empty;
        StateHasChanged();
        await _approversDialog!.ShowAsync();
        try
        {
            _persons ??= await AdministrationClient.GetPersonsAsync(CancellationToken.None);
            _approvers = await AdministrationClient.GetGroupApproversAsync(group.TargetGroupId, CancellationToken.None);
        }
        catch { _approverError = "Genehmigende konnten nicht geladen werden."; }
    }

    private async Task AddApproverAsync()
    {
        if (_approversGroup is null || !Guid.TryParse(_selectedApproverPersonId, out var personId)) return;
        _savingApprover = true;
        try
        {
            _approverError = null;
            await AdministrationClient.AddGroupApproverAsync(_approversGroup.TargetGroupId, personId, CancellationToken.None);
            _approvers = await AdministrationClient.GetGroupApproversAsync(_approversGroup.TargetGroupId, CancellationToken.None);
            _selectedApproverPersonId = string.Empty;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity) { _approverError = "Diese Person kann nicht als Approver zugeordnet werden. Sie benötigt ein aktives Anmeldekonto mit Approver-Recht (siehe Personenverwaltung)."; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict) { _approverError = "Diese Person ist der Gruppe bereits als aktiver Approver zugeordnet."; }
        catch { _approverError = "Die Zuordnung konnte nicht gespeichert werden."; }
        finally { _savingApprover = false; }
    }

    private async Task DeactivateApproverAsync(ManagedGroupApprover approver)
    {
        if (_approversGroup is null) return;
        _savingApprover = true;
        try
        {
            _approverError = null;
            await AdministrationClient.DeactivateGroupApproverAsync(_approversGroup.TargetGroupId, approver, CancellationToken.None);
            _approvers = await AdministrationClient.GetGroupApproversAsync(_approversGroup.TargetGroupId, CancellationToken.None);
        }
        catch { _approverError = "Die Zuordnung konnte nicht entfernt werden. Sie wurde möglicherweise zwischenzeitlich bereits geändert."; }
        finally { _savingApprover = false; }
    }

    private static string Hours(long seconds) => $"{seconds / 3600m:0.##} h";
    private static string SecondFactor(ManagedTargetGroup group) => !group.RequiresSecondFactor ? "Nein" : group.AllowedSecondFactorTypes switch { 1 => "FIDO2", 2 => "TOTP", 3 => "TOTP oder FIDO2", _ => "Ungültig" };

    private void EnsureSecondFactorTypeSelected()
    {
        if (_editor is not null && _editor.RequiresSecondFactor && _editor.AllowedSecondFactorTypes == 0)
        {
            _editor.AllowedSecondFactorTypes = 3;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        _newGroup = new(); _searchTerm = string.Empty; _searchResults = null; _searchError = null;
        StateHasChanged();
        await _createDialog!.ShowAsync();
    }

    private void CloseCreateDialog() { _newGroup = null; _searchResults = null; _searchError = null; }

    private async Task OpenEditDialogAsync(ManagedTargetGroup group)
    {
        _editor = new(group); _editorError = null;
        StateHasChanged();
        await _editDialog!.ShowAsync();
    }

    private async Task SearchAsync()
    {
        if (_searchTerm.Trim().Length < 2) { _searchError = "Bitte mindestens zwei Zeichen eingeben."; return; }
        _saving = true;
        try
        {
            _searchError = null;
            _searchResults = await AdministrationClient.SearchDirectoryGroupsAsync(_searchTerm, CancellationToken.None);
            if (_searchResults.Count == 0) _searchError = "Keine passende AD-Gruppe gefunden. Verfeinern Sie den Suchbegriff oder versuchen Sie einen Teil des sAMAccountName.";
        }
        catch { _searchError = "Die AD-Gruppensuche ist fehlgeschlagen. Bitte versuchen Sie es erneut."; }
        finally { _saving = false; }
    }

    private async Task CreateAsync()
    {
        if (_newGroup is null || !Guid.TryParse(_newGroup.ObjectGuid, out var id)) { _searchError = "Bitte zuerst eine AD-Gruppe auswählen."; return; }
        _saving = true;
        try
        {
            await AdministrationClient.CreateTargetGroupAsync(id, _newGroup.ToSeconds(_newGroup.MinimumHours), _newGroup.ToSeconds(_newGroup.MaximumHours), _newGroup.ToSeconds(_newGroup.DefaultHours), _newGroup.ToSeconds(_newGroup.StepHours), false, 0, false, false, CancellationToken.None);
            await _createDialog!.HideAsync();
            await LoadAsync();
        }
        catch { _searchError = "Die Gruppe konnte nicht registriert werden. Prüfen Sie die Auswahl und versuchen Sie es erneut."; }
        finally { _saving = false; }
    }

    private async Task SaveAsync()
    {
        if (_editor is null) return;
        _saving = true;
        try
        {
            _editorError = null;
            await AdministrationClient.UpdateTargetGroupPolicyAsync(_editor.ToContract(), CancellationToken.None);
            await _editDialog!.HideAsync();
            await LoadAsync();
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict) { _editorError = "Die Policy wurde zwischenzeitlich von anderer Stelle geändert. Schließen Sie den Dialog und bearbeiten Sie die Gruppe erneut mit dem aktuellen Stand."; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity) { _editorError = "Die Policy ist so nicht gültig. Prüfen Sie insbesondere: Bei \"Ticket erforderlich\" muss ein aktives Ticket-Pattern für diese Gruppe existieren; bei \"MFA erforderlich\" muss ein zweiter Faktor ausgewählt sein."; }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound) { _editorError = "Die Gruppe wurde nicht gefunden. Sie wurde möglicherweise inzwischen entfernt."; }
        catch { _editorError = "Die Policy konnte nicht gespeichert werden. Prüfen Sie Ihre Berechtigung und die geschützten Serverprotokolle."; }
        finally { _saving = false; }
    }

    private async Task DeactivateAsync()
    {
        if (_pendingDeactivation is null) return;
        _saving = true;
        try { await AdministrationClient.DeactivateTargetGroupAsync(_pendingDeactivation, CancellationToken.None); _pendingDeactivation = null; await LoadAsync(); }
        catch { _error = "Die Gruppe konnte nicht deaktiviert werden."; }
        finally { _saving = false; }
    }

    private async Task ReactivateAsync()
    {
        if (_pendingReactivation is null) return;
        _saving = true;
        try { await AdministrationClient.ReactivateTargetGroupAsync(_pendingReactivation, CancellationToken.None); _pendingReactivation = null; await LoadAsync(); }
        catch { _error = "Die Gruppe konnte nicht reaktiviert werden. Prüfen Sie, ob sie weiterhin in AD existiert."; }
        finally { _saving = false; }
    }

    private sealed class NewGroup
    {
        [System.ComponentModel.DataAnnotations.Required] public string ObjectGuid { get; set; } = string.Empty;
        public decimal MinimumHours { get; set; } = 1;
        public decimal MaximumHours { get; set; } = 8;
        public decimal DefaultHours { get; set; } = 1;
        public decimal StepHours { get; set; } = .5m;
        public long ToSeconds(decimal hours) => checked((long)(hours * 3600m));
    }

    private sealed class Editor
    {
        public Editor(ManagedTargetGroup group)
        {
            Source = group; DomainQualifiedName = group.DomainQualifiedName;
            MinimumHours = group.MinimumTtlSeconds / 3600m; MaximumHours = group.MaximumTtlSeconds / 3600m;
            DefaultHours = group.DefaultTtlSeconds / 3600m; StepHours = group.AllowedTtlStepSeconds / 3600m;
            RequiresSecondFactor = group.RequiresSecondFactor; AllowedSecondFactorTypes = group.AllowedSecondFactorTypes;
            RequiresTicket = group.RequiresTicket; RequiresApproval = group.RequiresApproval; IsEnabledForRequests = group.IsEnabledForRequests;
        }
        public ManagedTargetGroup Source { get; }
        public string DomainQualifiedName { get; }
        public decimal MinimumHours { get; set; }
        public decimal MaximumHours { get; set; }
        public decimal DefaultHours { get; set; }
        public decimal StepHours { get; set; }
        public bool RequiresSecondFactor { get; set; }
        public int AllowedSecondFactorTypes { get; set; }
        public bool RequiresTicket { get; set; }
        public bool RequiresApproval { get; set; }
        public bool IsEnabledForRequests { get; set; }
        public ManagedTargetGroup ToContract() => Source with
        {
            IsEnabledForRequests = IsEnabledForRequests,
            MinimumTtlSeconds = checked((long)(MinimumHours * 3600m)),
            MaximumTtlSeconds = checked((long)(MaximumHours * 3600m)),
            DefaultTtlSeconds = checked((long)(DefaultHours * 3600m)),
            AllowedTtlStepSeconds = checked((long)(StepHours * 3600m)),
            RequiresSecondFactor = RequiresSecondFactor,
            AllowedSecondFactorTypes = AllowedSecondFactorTypes,
            RequiresTicket = RequiresTicket,
            RequiresApproval = RequiresApproval
        };
    }
}

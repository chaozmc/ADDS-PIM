@page "/admin/identity-purge"
@using Microsoft.Extensions.Localization
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminIdentityPurge> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["HeroTitle"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(_activeTab == Tab.IdentityPurge ? "active" : null)" type="button" role="tab" aria-selected="@(_activeTab == Tab.IdentityPurge)" @onclick="() => _activeTab = Tab.IdentityPurge">
            <i class="bi bi-trash3-fill" aria-hidden="true"></i> @Localizer["TabIdentityPurge"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(_activeTab == Tab.OrphanedMfa ? "active" : null)" type="button" role="tab" aria-selected="@(_activeTab == Tab.OrphanedMfa)" @onclick="() => _activeTab = Tab.OrphanedMfa">
            <i class="bi bi-shield-exclamation" aria-hidden="true"></i> @Localizer["TabOrphanedMfa"]
            @if (_orphanedRequests is { Count: > 0 })
            {
                <span class="badge text-bg-danger ms-1">@_orphanedRequests.Count</span>
            }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(_activeTab == Tab.OrphanedApprovals ? "active" : null)" type="button" role="tab" aria-selected="@(_activeTab == Tab.OrphanedApprovals)" @onclick="() => _activeTab = Tab.OrphanedApprovals">
            <i class="bi bi-check2-square" aria-hidden="true"></i> @Localizer["TabOrphanedApprovals"]
            @if (_orphanedApprovals is { Count: > 0 })
            {
                <span class="badge text-bg-danger ms-1">@_orphanedApprovals.Count</span>
            }
        </button>
    </li>
</ul>

<div class="tab-content pt-4">
    @if (_activeTab == Tab.IdentityPurge)
    {
        <div role="tabpanel">
            <p>@Localizer["IdentityPurgeIntro"]</p>
            <section aria-labelledby="scope-title">
                <h2 id="scope-title">@Localizer["ScopeTitle"]</h2>
                <p>@Localizer["ScopeDescription"]</p>
                @if (_candidates is null)
                {
                    <LoadingIndicator Message="@Localizer["LoadingCandidates"]" />
                }
                else if (_candidates.Count == 0)
                {
                    <EmptyState Icon="bi-check-circle" Title="@Localizer["NothingToCleanTitle"]" Description="@Localizer["NothingToCleanCandidatesDescription"]" />
                }
                else
                {
                    <div class="row g-3 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label" for="initiator">@Localizer["ObjectLabel"]</label>
                            <select id="initiator" class="form-select" @bind="_selected">
                                <option value="">@Localizer["SelectPlaceholder"]</option>
                                @foreach (var candidate in _candidates)
                                {
                                    <option value="@Key(candidate)">@Label(candidate)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary" @onclick="LoadPreviewAsync" disabled="@_loading"><i class="bi bi-search" aria-hidden="true"></i> @Localizer["ComputeScopeButton"]</button>
                        </div>
                    </div>
                }
            </section>

            @if (_error is not null)
            {
                <p class="submission-result failed mt-4" role="alert">@_error</p>
            }
            @if (_success is not null)
            {
                <p class="submission-result succeeded mt-4" role="status">@_success</p>
            }

            @if (_preview is not null)
            {
                <section class="mt-4" aria-labelledby="result-title">
                    <h2 id="result-title">@Localizer["ResultTitle"]</h2>
                    <p><strong>@_preview.DisplayName</strong> (@_preview.InitiatorType)</p>
                    @if (_preview.IsEligible)
                    {
                        <p class="submission-result succeeded">@Localizer["ScopeEligibleMessage"]</p>
                    }
                    else
                    {
                        <p class="submission-result failed">@Localizer["ScopeNotEligiblePrefix", _preview.BlockingReason ?? string.Empty]</p>
                    }
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>@Localizer["TableHeaderEntity"]</th><th>@Localizer["TableHeaderCount"]</th></tr></thead>
                            <tbody>
                                <tr><td>@Localizer["RowPersons"]</td><td>@_preview.Persons</td></tr>
                                <tr><td>Directory Accounts</td><td>@_preview.DirectoryAccounts</td></tr>
                                <tr><td>@Localizer["RowPersonAccountLinks"]</td><td>@_preview.PersonAccountLinks</td></tr>
                                <tr><td>@Localizer["RowTargetGroupsPolicies"]</td><td>@_preview.TargetGroups / @_preview.GroupPolicies</td></tr>
                                <tr><td>@Localizer["RowDirectEntitlements"]</td><td>@_preview.DirectEntitlements</td></tr>
                                <tr><td>@Localizer["RowMembershipRequestsHistory"]</td><td>@_preview.MembershipRequests / @_preview.MembershipRequestStatusHistory</td></tr>
                                <tr><td>@Localizer["RowMfaTransactions"]</td><td>@_preview.MfaTransactions</td></tr>
                                <tr><td>@Localizer["RowTotpFactorsUsedSteps"]</td><td>@_preview.TotpFactors / @_preview.TotpUsedTimeSteps</td></tr>
                                <tr><td>FIDO2-Credentials</td><td>@_preview.Fido2Credentials</td></tr>
                            </tbody>
                        </table>
                    </div>
                    @if (_preview.IsEligible)
                    {
                        <DangerZonePanel Message="@Localizer["PurgeDangerMessage", _preview.InitiatorId]"
                                          ConfirmLabel="@Localizer["PurgeConfirmLabel"]" IsBusy="_loading" CanConfirm="@(_confirmation == ExpectedConfirmation)"
                                          OnConfirm="ExecuteAsync" OnCancel="() => _confirmation = string.Empty">
                            <input class="form-control" @bind="_confirmation" @bind:event="oninput" aria-label="Purge confirmation" placeholder="@ExpectedConfirmation" />
                            @if (!string.IsNullOrEmpty(_confirmation) && _confirmation != ExpectedConfirmation)
                            {
                                <div class="form-text text-danger">@Localizer["ConfirmationMismatchPrefix"] <code>@ExpectedConfirmation</code> @Localizer["ConfirmationMismatchSuffix"]</div>
                            }
                        </DangerZonePanel>
                    }
                </section>
            }
        </div>
    }
    else if (_activeTab == Tab.OrphanedMfa)
    {
        <div role="tabpanel">
            <p>@Localizer["OrphanedMfaDescriptionPart1"] <code>Expired</code> @Localizer["OrphanedMfaDescriptionPart2"]</p>
            @if (_orphanedError is not null)
            {
                <p class="submission-result failed" role="alert">@_orphanedError</p>
            }
            else if (_orphanedSuccess is not null)
            {
                <p class="submission-result succeeded" role="status">@_orphanedSuccess</p>
            }
            @if (_orphanedRequests is null)
            {
                <LoadingIndicator Message="@Localizer["LoadingOrphanedMfa"]" />
            }
            else if (_orphanedRequests.Count == 0)
            {
                <EmptyState Icon="bi-check-circle" Title="@Localizer["NothingToCleanTitle"]" Description="@Localizer["NothingToCleanOrphanedMfaDescription"]" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>@Localizer["TableHeaderPerson"]</th><th>@Localizer["TableHeaderTarget"]</th><th>@Localizer["TableHeaderGroup"]</th><th>@Localizer["TableHeaderCreatedUtc"]</th><th>@Localizer["TableHeaderWindowExpiredUtc"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var request in _orphanedRequests)
                            {
                                <tr>
                                    <td>@request.PersonDisplayName</td>
                                    <td>@request.TargetAccountDisplayName</td>
                                    <td>@request.TargetGroupDisplayName</td>
                                    <td>@request.CreatedUtc.ToString("u")</td>
                                    <td>@request.TransactionExpiresUtc.ToString("u")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_orphanedBusy" @onclick="() => ExpireOrphanedRequestAsync(request.RequestId)">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i> @Localizer["CleanupButton"]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div role="tabpanel">
            <p>@Localizer["OrphanedApprovalDescriptionPart1"] <code>Expired</code> @Localizer["OrphanedApprovalDescriptionPart2"] <code>AwaitingApproval</code> @Localizer["OrphanedApprovalDescriptionPart3"]</p>
            @if (_orphanedApprovalError is not null)
            {
                <p class="submission-result failed" role="alert">@_orphanedApprovalError</p>
            }
            else if (_orphanedApprovalSuccess is not null)
            {
                <p class="submission-result succeeded" role="status">@_orphanedApprovalSuccess</p>
            }
            @if (_orphanedApprovals is null)
            {
                <LoadingIndicator Message="@Localizer["LoadingOrphanedApprovals"]" />
            }
            else if (_orphanedApprovals.Count == 0)
            {
                <EmptyState Icon="bi-check-circle" Title="@Localizer["NothingToCleanTitle"]" Description="@Localizer["NothingToCleanOrphanedApprovalsDescription"]" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>@Localizer["TableHeaderPerson"]</th><th>@Localizer["TableHeaderTarget"]</th><th>@Localizer["TableHeaderGroup"]</th><th>@Localizer["TableHeaderCreatedUtc"]</th><th>@Localizer["TableHeaderWaitingSinceUtc"]</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var request in _orphanedApprovals)
                            {
                                <tr>
                                    <td>@request.PersonDisplayName</td>
                                    <td>@request.TargetAccountDisplayName</td>
                                    <td>@request.TargetGroupDisplayName</td>
                                    <td>@request.CreatedUtc.ToString("u")</td>
                                    <td>@request.EnteredAwaitingApprovalUtc.ToString("u")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_orphanedApprovalBusy" @onclick="() => ExpireOrphanedApprovalAsync(request.RequestId)">
                                            <i class="bi bi-x-circle" aria-hidden="true"></i> @Localizer["CleanupButton"]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private enum Tab { IdentityPurge, OrphanedMfa, OrphanedApprovals }
    private Tab _activeTab = Tab.IdentityPurge;

    private IReadOnlyList<IdentityPurgeCandidate>? _candidates;
    private string _selected = string.Empty;
    private bool _loading;
    private string? _error;
    private string? _success;
    private IdentityPurgeScopePreview? _preview;
    private string _confirmation = string.Empty;
    private IReadOnlyList<ManagedOrphanedSecondFactorRequest>? _orphanedRequests;
    private string? _orphanedError;
    private string? _orphanedSuccess;
    private bool _orphanedBusy;
    private IReadOnlyList<ManagedOrphanedApprovalRequest>? _orphanedApprovals;
    private string? _orphanedApprovalError;
    private string? _orphanedApprovalSuccess;
    private bool _orphanedApprovalBusy;

    private string ExpectedConfirmation => _preview is null ? string.Empty : $"PURGE {_preview.InitiatorId}";

    protected override async Task OnInitializedAsync()
    {
        try { _candidates = await AdministrationClient.GetIdentityPurgeCandidatesAsync(CancellationToken.None); }
        catch { _error = Localizer["LoadCandidatesError"]; _candidates = []; }
        await LoadOrphanedRequestsAsync();
        await LoadOrphanedApprovalsAsync();
    }

    private async Task LoadOrphanedRequestsAsync()
    {
        try { _orphanedError = null; _orphanedRequests = await AdministrationClient.GetOrphanedSecondFactorRequestsAsync(CancellationToken.None); }
        catch { _orphanedError = Localizer["OrphanedMfaLoadError"]; _orphanedRequests = []; }
    }

    private async Task ExpireOrphanedRequestAsync(Guid requestId)
    {
        _orphanedBusy = true;
        try
        {
            _orphanedError = null; _orphanedSuccess = null;
            await AdministrationClient.ExpireOrphanedSecondFactorRequestAsync(requestId, CancellationToken.None);
            _orphanedSuccess = Localizer["RequestExpiredSuccess"];
            await LoadOrphanedRequestsAsync();
        }
        catch { _orphanedError = Localizer["OrphanedMfaExpireError"]; }
        finally { _orphanedBusy = false; }
    }

    private async Task LoadOrphanedApprovalsAsync()
    {
        try { _orphanedApprovalError = null; _orphanedApprovals = await AdministrationClient.GetOrphanedApprovalRequestsAsync(CancellationToken.None); }
        catch { _orphanedApprovalError = Localizer["OrphanedApprovalLoadError"]; _orphanedApprovals = []; }
    }

    private async Task ExpireOrphanedApprovalAsync(Guid requestId)
    {
        _orphanedApprovalBusy = true;
        try
        {
            _orphanedApprovalError = null; _orphanedApprovalSuccess = null;
            await AdministrationClient.ExpireOrphanedApprovalRequestAsync(requestId, CancellationToken.None);
            _orphanedApprovalSuccess = Localizer["RequestExpiredSuccess"];
            await LoadOrphanedApprovalsAsync();
        }
        catch { _orphanedApprovalError = Localizer["OrphanedApprovalExpireError"]; }
        finally { _orphanedApprovalBusy = false; }
    }

    private async Task LoadPreviewAsync()
    {
        if (!TrySelected(out var type, out var id)) { _error = Localizer["SelectObjectError"]; return; }
        _loading = true;
        try { _error = null; _success = null; _confirmation = string.Empty; _preview = await AdministrationClient.GetIdentityPurgeScopePreviewAsync(type, id, CancellationToken.None); }
        catch { _error = Localizer["ScopePreviewLoadError"]; _preview = null; }
        finally { _loading = false; }
    }

    private async Task ExecuteAsync()
    {
        if (_preview is null) return;
        _loading = true;
        try
        {
            _error = null;
            await AdministrationClient.ExecuteIdentityPurgeAsync(_preview.InitiatorType, _preview.InitiatorId, _confirmation, CancellationToken.None);
            _preview = null; _confirmation = string.Empty; _selected = string.Empty;
            _candidates = await AdministrationClient.GetIdentityPurgeCandidatesAsync(CancellationToken.None);
            _success = Localizer["PurgeSuccessMessage"];
        }
        catch { _error = Localizer["PurgeExecuteError"]; }
        finally { _loading = false; }
    }

    private bool TrySelected(out string type, out Guid id)
    {
        var parts = _selected.Split('|', 2); type = parts[0]; id = Guid.Empty; return parts.Length == 2 && Guid.TryParse(parts[1], out id);
    }
    private static string Key(IdentityPurgeCandidate candidate) => $"{candidate.InitiatorType}|{candidate.InitiatorId:D}";
    private static string Label(IdentityPurgeCandidate candidate) => $"{candidate.InitiatorType}: {candidate.DisplayName}";
}

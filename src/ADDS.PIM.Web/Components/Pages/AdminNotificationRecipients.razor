@page "/admin/settings/notification-recipients"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminNotificationRecipients> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject ILogger<AdminNotificationRecipients> Logger

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["Heading"]</h1>
        <p>@Localizer["IntroText"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_recipients is null || _groups is null)
{
    <LoadingIndicator Message="@Localizer["LoadingMessage"]" />
}
else
{
    <section>
        <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
            <button class="btn btn-primary" @onclick="New"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["AddRecipientButton"]</button>
            <div>
                <label for="recipient-group-filter" class="form-label">@Localizer["GroupFilterLabel"]</label>
                <input id="recipient-group-filter" class="form-control" @bind="_groupFilter" @bind:event="oninput" placeholder="@Localizer["GroupFilterPlaceholder"]" />
            </div>
        </div>

        @if (FilteredGroups.Count == 0)
        {
            <EmptyState Icon="bi-envelope-exclamation" Title="@Localizer["EmptyStateTitle"]" Description="@Localizer["EmptyStateDescription"]" />
        }
        else
        {
            @foreach (var group in FilteredGroups)
            {
                var groupExpanded = _expandedGroupId == group.TargetGroupId;
                <div class="card mb-2">
                    <div class="card-header" role="button" tabindex="0" aria-expanded="@groupExpanded" @onclick="() => ToggleGroup(group.TargetGroupId)">
                        <i class="bi @(groupExpanded ? "bi-chevron-down" : "bi-chevron-right") me-1" aria-hidden="true"></i>
                        <strong>@group.TargetGroupDisplayName</strong>
                        <span class="ms-2 text-muted">(@(group.Recipients.Count == 1 ? Localizer["RecipientCountSingular", group.Recipients.Count] : Localizer["RecipientCountPlural", group.Recipients.Count]))</span>
                    </div>
                    @if (groupExpanded)
                    {
                        <div class="card-body">
                            <table class="table table-sm mb-0">
                                <thead><tr><th>@Localizer["EmailColumnHeader"]</th><th>@Localizer["RecipientTypeColumnHeader"]</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var recipient in group.Recipients)
                                    {
                                        <tr>
                                            <td>@recipient.EmailAddress</td>
                                            <td>@RecipientTypeLabel(recipient.RecipientType)</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-secondary" @onclick="() => _editor = new(recipient)"><i class="bi bi-pencil-square" aria-hidden="true"></i> @Localizer["EditButton"]</button>
                                                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => _pendingDeletion = recipient"><i class="bi bi-trash3" aria-hidden="true"></i> @SharedLocalizer["DeleteButton"]</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }

        @if (_pendingDeletion is not null)
        {
            <DangerZonePanel Message="@Localizer["DeleteConfirmMessage", _pendingDeletion.EmailAddress]"
                              ConfirmLabel="@Localizer["DeletePermanentlyButton"]" IsBusy="_saving"
                              OnConfirm="DeleteAsync" OnCancel="() => _pendingDeletion = null" />
        }

        @if (_editor is not null)
        {
            <EditForm Model="_editor" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="card">
                    <div class="card-body">
                        <h2 class="h4">@(_editor.IsNew ? Localizer["AddRecipientHeading"] : Localizer["EditRecipientHeading"])</h2>
                        <div class="mb-3">
                            <label>@Localizer["GroupLabel"]</label>
                            <InputSelect class="form-select" @bind-Value="_editor.TargetGroupId" disabled="@(!_editor.IsNew)">
                                <option value="">@Localizer["PleaseSelectOption"]</option>
                                @foreach (var group in _groups)
                                {
                                    <option value="@group.TargetGroupId">@group.DomainQualifiedName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>@Localizer["EmailAddressLabel"]</label>
                            <InputText class="form-control" @bind-Value="_editor.EmailAddress" />
                        </div>
                        <div class="mb-3">
                            <label>@Localizer["RecipientTypeLabel"]</label>
                            <InputSelect class="form-select" @bind-Value="_editor.RecipientType">
                                <option value="@MailRecipientType.To">@Localizer["RecipientTypeTo"]</option>
                                <option value="@MailRecipientType.Cc">@Localizer["RecipientTypeCc"]</option>
                                <option value="@MailRecipientType.Bcc">@Localizer["RecipientTypeBcc"]</option>
                            </InputSelect>
                        </div>
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_editor.IsActive" />
                            <label class="form-check-label">@Localizer["ActiveLabel"]</label>
                        </div>
                        <p class="mt-3">
                            <button class="btn btn-primary" type="submit" disabled="@_saving">@SharedLocalizer["SaveButton"]</button>
                            <button class="btn btn-secondary ms-2" type="button" @onclick="() => _editor = null">@SharedLocalizer["CancelButton"]</button>
                        </p>
                    </div>
                </div>
            </EditForm>
        }
    </section>
}

@code {
    private IReadOnlyList<ManagedGroupNotificationRecipient>? _recipients;
    private IReadOnlyList<ManagedTargetGroup>? _groups;
    private string? _error;
    private bool _saving;
    private Editor? _editor;
    private ManagedGroupNotificationRecipient? _pendingDeletion;
    private string _groupFilter = string.Empty;
    private Guid? _expandedGroupId;

    private IReadOnlyList<GroupRecipients> FilteredGroups => (_recipients ?? [])
        .Where(recipient => recipient.IsActive)
        .GroupBy(recipient => recipient.TargetGroupId)
        .Select(group => new GroupRecipients(group.Key, group.First().TargetGroupDisplayName, group.OrderBy(recipient => recipient.EmailAddress).ToArray()))
        .Where(group => string.IsNullOrWhiteSpace(_groupFilter) || group.TargetGroupDisplayName.Contains(_groupFilter, StringComparison.OrdinalIgnoreCase))
        .OrderBy(group => group.TargetGroupDisplayName)
        .ToArray();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            _recipients = await AdministrationClient.GetGroupNotificationRecipientsAsync(CancellationToken.None);
            _groups = await AdministrationClient.GetTargetGroupsAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load group notification recipients.");
            _error = Localizer["LoadRecipientsError"];
        }
    }

    private string RecipientTypeLabel(MailRecipientType type) => type switch
    {
        MailRecipientType.Cc => Localizer["RecipientTypeCc"],
        MailRecipientType.Bcc => Localizer["RecipientTypeBcc"],
        _ => Localizer["RecipientTypeTo"],
    };

    private void New() => _editor = new Editor();

    private void ToggleGroup(Guid targetGroupId) => _expandedGroupId = _expandedGroupId == targetGroupId ? null : targetGroupId;

    private async Task SaveAsync()
    {
        if (_editor is null || !Guid.TryParse(_editor.TargetGroupId, out var groupId))
        {
            _error = Localizer["SelectGroupRequired"];
            return;
        }
        _saving = true;
        try
        {
            await AdministrationClient.UpsertGroupNotificationRecipientAsync(_editor.ToContract(groupId), CancellationToken.None);
            _editor = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save group notification recipient for TargetGroupId {TargetGroupId}.", groupId);
            _error = Localizer["SaveRecipientError"];
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var pendingDeletion = _pendingDeletion;
        if (pendingDeletion is null) return;
        _saving = true;
        try
        {
            await AdministrationClient.DeleteGroupNotificationRecipientAsync(pendingDeletion, CancellationToken.None);
            _pendingDeletion = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete group notification recipient {GroupNotificationRecipientId}.", pendingDeletion.GroupNotificationRecipientId);
            _error = Localizer["DeleteRecipientError"];
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record GroupRecipients(Guid TargetGroupId, string TargetGroupDisplayName, IReadOnlyList<ManagedGroupNotificationRecipient> Recipients);

    private sealed class Editor
    {
        public Editor() { IsNew = true; }
        public Editor(ManagedGroupNotificationRecipient source) { Source = source; TargetGroupId = source.TargetGroupId.ToString(); EmailAddress = source.EmailAddress; RecipientType = source.RecipientType; IsActive = source.IsActive; }

        public bool IsNew { get; }
        public ManagedGroupNotificationRecipient? Source { get; }

        [System.ComponentModel.DataAnnotations.Required]
        public string TargetGroupId { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress, System.ComponentModel.DataAnnotations.StringLength(320)]
        public string EmailAddress { get; set; } = string.Empty;

        public MailRecipientType RecipientType { get; set; } = MailRecipientType.To;

        public bool IsActive { get; set; } = true;

        public ManagedGroupNotificationRecipient ToContract(Guid groupId)
            => new(Source?.GroupNotificationRecipientId ?? Guid.Empty, groupId, string.Empty, EmailAddress, RecipientType, IsActive, Source?.RowVersion ?? string.Empty);
    }
}

@page "/admin/persons/{PersonId:guid}"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminPersonDetail> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["HeroTitle"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_detail is null)
{
    <LoadingIndicator Message="@Localizer["LoadingPersonAccounts"]" />
}
else
{
    <section>
        <h2>@_detail.Person.DisplayName</h2>
        <p>@Localizer["StatusLabel"] <StatusBadge Text="@(_detail.Person.IsActive ? Localizer["StatusActive"] : Localizer["StatusDeactivated"])" Variant="@(_detail.Person.IsActive ? StatusBadge.BadgeVariant.Success : StatusBadge.BadgeVariant.Neutral)" /></p>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">@Localizer["LinkedAccountsTitle"]</h3>
            <button class="btn btn-primary" @onclick="OpenAddDialogAsync" disabled="@(!_detail.Person.IsActive)"><i class="bi bi-link-45deg" aria-hidden="true"></i> @Localizer["AssignAccountButton"]</button>
        </div>
        @if (!_detail.Person.IsActive)
        {
            <p class="text-muted"><i class="bi bi-info-circle" aria-hidden="true"></i> @Localizer["InactivePersonNotice"]</p>
        }

        @if (_detail.Accounts.Count == 0)
        {
            <EmptyState Icon="bi-person-lines-fill" Title="@Localizer["NoLinkedAccountsTitle"]" Description="@Localizer["NoLinkedAccountsDescription"]" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>@Localizer["TableHeaderAccount"]</th><th>@Localizer["TableHeaderAdStatus"]</th><th>@Localizer["TableHeaderPurposes"]</th><th>@Localizer["TableHeaderStatus"]</th><th>@Localizer["TableHeaderActions"]</th></tr></thead>
                    <tbody>
                        @foreach (var link in _detail.Accounts)
                        {
                            <tr>
                                <td><strong>@link.DomainQualifiedName</strong><br /><small>@link.DisplayName · @link.UserPrincipalName</small></td>
                                <td><StatusBadge Text="@(link.IsEnabledInDirectory ? Localizer["StatusActive"] : Localizer["StatusDeactivated"])" Variant="@(link.IsEnabledInDirectory ? StatusBadge.BadgeVariant.Success : StatusBadge.BadgeVariant.Neutral)" /></td>
                                <td>@PurposeText(link)</td>
                                <td><StatusBadge Text="@(link.IsActive ? Localizer["StatusAssigned"] : Localizer["StatusDeactivated"])" Variant="@(link.IsActive ? StatusBadge.BadgeVariant.Success : StatusBadge.BadgeVariant.Neutral)" /></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" @onclick="() => OpenPurposeDialogAsync(link)" disabled="@(!link.IsActive || !_detail.Person.IsActive)"><i class="bi bi-sliders" aria-hidden="true"></i> @Localizer["ChangePurposeButton"]</button>
                                        @if (link.IsActive)
                                        {
                                            <button class="btn btn-outline-danger" @onclick="() => _pendingDeactivate = link"><i class="bi bi-slash-circle" aria-hidden="true"></i> @Localizer["DeactivateButton"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary" @onclick="() => _pendingReactivate = link" disabled="@(!_detail.Person.IsActive)"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @Localizer["ReactivateButton"]</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_pendingDeactivate is not null)
        {
            <DangerZonePanel Message="@Localizer["DeactivateLinkDangerMessage", _pendingDeactivate.DomainQualifiedName]"
                              ConfirmLabel="@Localizer["DeactivateButton"]" IsBusy="_saving"
                              OnConfirm="() => SetLinkActiveAsync(false)" OnCancel="() => _pendingDeactivate = null" />
        }

        @if (_pendingReactivate is not null)
        {
            <div class="alert alert-primary d-flex justify-content-between align-items-center mt-3">
                <span>@Localizer["ReactivateLinkPrompt", _pendingReactivate.DomainQualifiedName]</span>
                <span class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="() => SetLinkActiveAsync(true)" disabled="@_saving">@Localizer["ReactivateButton"]</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _pendingReactivate = null" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
                </span>
            </div>
        }
    </section>
}

<ConfirmDialog @ref="_addDialog" Title="@Localizer["AssignAccountDialogTitle"]" OnClosed="CloseAddDialog">
    <p>@Localizer["AssignAccountDialogIntro"]</p>
    <div class="input-group">
        <input class="form-control" @bind="_searchTerm" placeholder="@Localizer["SearchPlaceholder"]" />
        <button class="btn btn-outline-secondary" @onclick="SearchAsync" disabled="@_saving">@Localizer["SearchButton"]</button>
    </div>
    @if (_searchError is not null)
    {
        <p class="text-danger mt-2">@_searchError</p>
    }
    @if (_searchResults is not null)
    {
        <table class="table mt-3">
            <thead><tr><th>@Localizer["TableHeaderName"]</th><th>@Localizer["TableHeaderAccount"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var account in _searchResults)
                {
                    <tr>
                        <td>@account.DisplayName</td>
                        <td><strong>@account.DomainQualifiedName</strong><br /><small>@account.UserPrincipalName</small></td>
                        <td><button class="btn btn-primary" @onclick="() => SelectAccount(account)">@Localizer["SelectButton"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (_selectedAccount is not null)
    {
        <hr />
        <p><strong>@Localizer["SelectedLabel"]</strong> @_selectedAccount.DomainQualifiedName</p>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="new-may-authenticate" @bind="_newMayAuthenticate" disabled="@HasActiveAuthenticationAccount" />
            <label class="form-check-label" for="new-may-authenticate">@Localizer["MayAuthenticateLabel"]</label>
            <i class="bi bi-info-circle text-muted ms-1" title="@AuthenticationPurposeTooltip"></i>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="new-may-receive-privileges" @bind="_newMayReceivePrivileges" />
            <label class="form-check-label" for="new-may-receive-privileges">@Localizer["MayReceivePrivilegesLabel"]</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="new-may-approve" @bind="_newMayApprove" disabled="@(!_newMayAuthenticate)" />
            <label class="form-check-label" for="new-may-approve">@Localizer["MayApproveLabel"]</label>
            <i class="bi bi-info-circle text-muted ms-1" title="@Localizer["ApproveOnlyOnLoginAccountTooltip"]"></i>
        </div>
        <p class="text-muted mt-2">@Localizer["MinimumOnePurposeNotice"]</p>
    }
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-secondary" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
        <button class="btn btn-primary" @onclick="CreateLinkAsync" disabled="@(_saving || _selectedAccount is null)">@Localizer["AssignAccountButton"]</button>
    </div>
</ConfirmDialog>

<ConfirmDialog @ref="_purposeDialog" Title="@Localizer["ChangePurposesDialogTitle"]" OnClosed="() => { _purposeLink = null; _purposeError = null; }">
    @if (_purposeLink is not null)
    {
        <p>@_purposeLink.DomainQualifiedName</p>
        @if (_purposeError is not null)
        {
            <p class="alert alert-danger" role="alert">@_purposeError</p>
        }
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="edit-may-authenticate" @bind="_editMayAuthenticate" disabled="@HasAnotherActiveAuthenticationAccount" />
            <label class="form-check-label" for="edit-may-authenticate">@Localizer["InteractiveAuthenticationLabel"]</label>
            <i class="bi bi-info-circle text-muted ms-1" title="@AuthenticationPurposeTooltip"></i>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="edit-may-receive-privileges" @bind="_editMayReceivePrivileges" />
            <label class="form-check-label" for="edit-may-receive-privileges">@Localizer["ReceiveTtlPrivilegesLabel"]</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="edit-may-approve" @bind="_editMayApprove" disabled="@(!_editMayAuthenticate)" />
            <label class="form-check-label" for="edit-may-approve">@Localizer["DecideApprovalsLabel"]</label>
            <i class="bi bi-info-circle text-muted ms-1" title="@Localizer["ApproveOnlyOnLoginAccountTooltip"]"></i>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-secondary" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
            <button class="btn btn-primary" @onclick="SavePurposesAsync" disabled="@_saving">@SharedLocalizer["SaveButton"]</button>
        </div>
    }
</ConfirmDialog>

@code {
    [Parameter] public Guid PersonId { get; set; }
    private ManagedPersonDetail? _detail;
    private string? _error;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private string? _searchError;
    private IReadOnlyList<DirectoryUserSearchResult>? _searchResults;
    private DirectoryUserSearchResult? _selectedAccount;
    private bool _newMayAuthenticate;
    private bool _newMayReceivePrivileges = true;
    private bool _newMayApprove;
    private ManagedPersonAccountLink? _purposeLink;
    private string? _purposeError;
    private bool _editMayAuthenticate;
    private bool _editMayReceivePrivileges;
    private bool _editMayApprove;
    private ManagedPersonAccountLink? _pendingDeactivate;
    private ManagedPersonAccountLink? _pendingReactivate;
    private ConfirmDialog? _addDialog;
    private ConfirmDialog? _purposeDialog;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _error = null; _detail = await AdministrationClient.GetPersonDetailAsync(PersonId, CancellationToken.None); }
        catch { _error = Localizer["LoadPersonError"]; }
    }

    private async Task OpenAddDialogAsync()
    {
        _searchTerm = string.Empty; _searchError = null; _searchResults = null; _selectedAccount = null; _newMayAuthenticate = false; _newMayReceivePrivileges = true; _newMayApprove = false;
        StateHasChanged();
        await _addDialog!.ShowAsync();
    }

    private void CloseAddDialog() { _searchResults = null; _selectedAccount = null; _searchError = null; }

    private async Task SearchAsync()
    {
        if (_searchTerm.Trim().Length < 2) { _searchError = Localizer["SearchMinLengthError"]; return; }
        _saving = true;
        try
        {
            _searchError = null;
            _searchResults = await AdministrationClient.SearchDirectoryAccountsAsync(_searchTerm, CancellationToken.None);
            if (_searchResults.Count == 0) _searchError = Localizer["NoMatchingAccountError"];
        }
        catch { _searchError = Localizer["SearchFailedError"]; }
        finally { _saving = false; }
    }

    private void SelectAccount(DirectoryUserSearchResult account) { _selectedAccount = account; _searchError = null; }

    private async Task CreateLinkAsync()
    {
        if (_selectedAccount is null || (!_newMayAuthenticate && !_newMayReceivePrivileges)) { _searchError = Localizer["SelectAtLeastOnePurposeError"]; return; }
        if (!_newMayAuthenticate) _newMayApprove = false;
        _saving = true;
        try
        {
            await AdministrationClient.CreatePersonAccountLinkAsync(PersonId, _selectedAccount.ObjectGuid, _newMayAuthenticate, _newMayReceivePrivileges, _newMayApprove, CancellationToken.None);
            await _addDialog!.HideAsync();
            await LoadAsync();
        }
        catch { _searchError = Localizer["CreateLinkError"]; }
        finally { _saving = false; }
    }

    private async Task OpenPurposeDialogAsync(ManagedPersonAccountLink link)
    {
        _purposeLink = link; _purposeError = null; _editMayAuthenticate = link.MayAuthenticate; _editMayReceivePrivileges = link.MayReceivePrivileges; _editMayApprove = link.MayApprove;
        StateHasChanged();
        await _purposeDialog!.ShowAsync();
    }

    private async Task SavePurposesAsync()
    {
        if (_purposeLink is null || (!_editMayAuthenticate && !_editMayReceivePrivileges)) { _purposeError = Localizer["MinimumOnePurposeError"]; return; }
        if (!_editMayAuthenticate) _editMayApprove = false;
        _saving = true;
        try
        {
            _purposeError = null;
            await AdministrationClient.UpdatePersonAccountLinkPurposesAsync(PersonId, _purposeLink, _editMayAuthenticate, _editMayReceivePrivileges, _editMayApprove, CancellationToken.None);
            await _purposeDialog!.HideAsync();
            await LoadAsync();
        }
        catch { _purposeError = Localizer["SavePurposesError"]; }
        finally { _saving = false; }
    }

    private async Task SetLinkActiveAsync(bool active)
    {
        var link = active ? _pendingReactivate : _pendingDeactivate;
        if (link is null) return;
        _saving = true;
        try { await AdministrationClient.SetPersonAccountLinkActiveAsync(PersonId, link, active, CancellationToken.None); _pendingDeactivate = null; _pendingReactivate = null; await LoadAsync(); }
        catch { _error = Localizer["SetLinkActiveError"]; }
        finally { _saving = false; }
    }

    private string PurposeText(ManagedPersonAccountLink link) => string.Join(", ", new[] { link.MayAuthenticate ? Localizer["PurposeAuthentication"].Value : null, link.MayReceivePrivileges ? Localizer["PurposePrivilegeTarget"].Value : null }.Where(value => value is not null));
    private bool HasActiveAuthenticationAccount => _detail?.Accounts.Any(link => link.IsActive && link.MayAuthenticate) ?? false;
    private bool HasAnotherActiveAuthenticationAccount => _purposeLink is not null && (_detail?.Accounts.Any(link => link.IsActive && link.MayAuthenticate && link.PersonAccountLinkId != _purposeLink.PersonAccountLinkId) ?? false);
    private string AuthenticationPurposeTooltip => Localizer["AuthenticationPurposeTooltip"];
}

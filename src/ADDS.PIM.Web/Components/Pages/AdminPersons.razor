@page "/admin/persons"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminPersons> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["HeroTitle"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_persons is null)
{
    <LoadingIndicator Message="@Localizer["LoadingPersons"]" />
}
else
{
    var activePersons = _persons.Where(person => person.IsActive).ToArray();
    var inactivePersons = _persons.Where(person => !person.IsActive).ToArray();

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>@Localizer["ActivePersonsTitle"]</h2>
            <button class="btn btn-primary" @onclick="OpenCreateDialogAsync"><i class="bi bi-person-plus-fill" aria-hidden="true"></i> @Localizer["CreatePersonButton"]</button>
        </div>

        @if (activePersons.Length == 0)
        {
            <EmptyState Icon="bi-people" Title="@Localizer["NoActivePersonsTitle"]" Description="@Localizer["NoActivePersonsDescription"]" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>@Localizer["TableHeaderName"]</th><th>@Localizer["TableHeaderSince"]</th><th>@Localizer["TableHeaderActions"]</th></tr></thead>
                    <tbody>
                        @foreach (var person in activePersons)
                        {
                            <tr>
                                <td>@person.DisplayName</td>
                                <td>@person.ValidFromUtc.ToLocalTime().ToString("d")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a class="btn btn-outline-primary" href="@($"admin/persons/{person.PersonId:D}")"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> @Localizer["AccountsButton"]</a>
                                        <button class="btn btn-outline-secondary" @onclick="() => OpenMfaDialogAsync(person)"><i class="bi bi-shield-lock" aria-hidden="true"></i> @Localizer["MfaButton"]</button>
                                        <button class="btn btn-outline-danger" @onclick="() => _pendingDeactivation = person"><i class="bi bi-slash-circle" aria-hidden="true"></i> @Localizer["DeactivateButton"]</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_pendingDeactivation is not null)
        {
            <DangerZonePanel Message="@Localizer["DeactivatePersonDangerMessage", _pendingDeactivation.DisplayName]"
                              ConfirmLabel="@Localizer["DeactivatePersonConfirmLabel"]" IsBusy="_saving"
                              OnConfirm="() => SetActiveAsync(false)" OnCancel="() => _pendingDeactivation = null" />
        }

        @if (inactivePersons.Length > 0)
        {
            <div class="mt-4">
                <button class="btn btn-link ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#inactive-persons">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i> @Localizer["InactivePersonsToggle", inactivePersons.Length]
                </button>
                <div class="collapse" id="inactive-persons">
                    <table class="table mt-2">
                        <tbody>
                            @foreach (var person in inactivePersons)
                            {
                                <tr>
                                    <td>@person.DisplayName</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a class="btn btn-outline-primary" href="@($"admin/persons/{person.PersonId:D}")"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> @Localizer["AccountsButton"]</a>
                                            <button class="btn btn-outline-secondary" @onclick="() => OpenMfaDialogAsync(person)"><i class="bi bi-shield-lock" aria-hidden="true"></i> @Localizer["MfaButton"]</button>
                                            <button class="btn btn-primary" @onclick="() => _pendingReactivation = person"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @Localizer["ReactivateButton"]</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (_pendingReactivation is not null)
        {
            <div class="alert alert-primary d-flex justify-content-between align-items-center mt-3">
                <span>@Localizer["ReactivatePersonPrompt", _pendingReactivation.DisplayName]</span>
                <span class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="() => SetActiveAsync(true)" disabled="@_saving">@Localizer["ReactivateButton"]</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _pendingReactivation = null" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
                </span>
            </div>
        }
    </section>
}

<ConfirmDialog @ref="_createDialog" Title="@Localizer["OnboardPersonDialogTitle"]" OnClosed="CloseCreateDialog">
    <p>@Localizer["OnboardPersonDialogIntro"]</p>
    <div class="input-group">
        <input class="form-control" @bind="_searchTerm" placeholder="@Localizer["SearchPlaceholder"]" />
        <button class="btn btn-outline-secondary" type="button" @onclick="SearchAsync" disabled="@_saving">@Localizer["SearchButton"]</button>
    </div>
    @if (_searchError is not null)
    {
        <p class="text-danger mt-2" role="alert">@_searchError</p>
    }
    @if (_searchResults is not null && _searchResults.Count > 0)
    {
        <table class="table table-hover mt-3">
            <thead><tr><th>@Localizer["TableHeaderName"]</th><th>@Localizer["TableHeaderAccount"]</th><th>@Localizer["TableHeaderEmail"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var user in _searchResults)
                {
                    <tr>
                        <td>@user.DisplayName</td>
                        <td><strong>@user.DomainQualifiedName</strong><br /><small>@user.UserPrincipalName</small></td>
                        <td>@user.EmailAddress</td>
                        <td><button class="btn btn-primary" @onclick="() => OnboardAsync(user)" disabled="@_saving">@Localizer["SelectButton"]</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal" disabled="@_saving">@SharedLocalizer["CancelButton"]</button>
    </div>
</ConfirmDialog>

<ConfirmDialog @ref="_mfaDialog" Title="@Localizer["MfaFactorsDialogTitle", _mfaPerson?.DisplayName ?? string.Empty]" OnClosed="CloseMfaDialog">
    @if (_mfaLoading)
    {
        <LoadingIndicator Message="@Localizer["LoadingFactors"]" />
    }
    else if (_mfaError is not null)
    {
        <p class="text-danger" role="alert">@_mfaError</p>
    }
    else if (_mfaFactors is { Count: 0 })
    {
        <p>@Localizer["NoTotpFactorMessage"]</p>
    }
    else if (_mfaFactors is not null)
    {
        <table class="table table-sm">
            <thead><tr><th>@Localizer["TableHeaderEnrolled"]</th><th>@Localizer["TableHeaderConfirmed"]</th><th>@Localizer["TableHeaderStatus"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var factor in _mfaFactors)
                {
                    <tr>
                        <td>@factor.EnrolledUtc.ToLocalTime().ToString("g")</td>
                        <td>@(factor.ConfirmedUtc?.ToLocalTime().ToString("g") ?? "–")</td>
                        <td>@MfaFactorStatus(factor)</td>
                        <td>
                            @if (factor.IsActive && factor.RevokedUtc is null)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => _pendingRevoke = factor" disabled="@_revoking"><i class="bi bi-shield-x" aria-hidden="true"></i> @Localizer["RevokeButton"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_pendingRevoke is not null)
        {
            <DangerZonePanel Message="@Localizer["RevokeTotpFactorDangerMessage"]"
                              ConfirmLabel="@Localizer["RevokeFinalConfirmLabel"]" IsBusy="_revoking"
                              OnConfirm="RevokeFactorAsync" OnCancel="() => _pendingRevoke = null" />
        }
    }

    <hr />
    <h6>@Localizer["Fido2PasskeysTitle"]</h6>
    @if (_fido2Credentials is { Count: 0 })
    {
        <p>@Localizer["NoPasskeyMessage"]</p>
    }
    else if (_fido2Credentials is not null)
    {
        <table class="table table-sm">
            <thead><tr><th>@Localizer["TableHeaderLabel"]</th><th>@Localizer["TableHeaderEnrolled"]</th><th>@Localizer["TableHeaderStatus"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var credential in _fido2Credentials)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(credential.Label) ? "–" : credential.Label)</td>
                        <td>@credential.CreatedUtc.ToLocalTime().ToString("g")</td>
                        <td>@(credential.RevokedUtc is { } revokedUtc ? Localizer["RevokedOnLabel", revokedUtc.ToLocalTime().ToString("g")].Value : Localizer["ActiveLabel"].Value)</td>
                        <td>
                            @if (credential.RevokedUtc is null)
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => _pendingRevokeFido2 = credential" disabled="@_revoking"><i class="bi bi-shield-x" aria-hidden="true"></i> @Localizer["RevokeButton"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_pendingRevokeFido2 is not null)
        {
            <DangerZonePanel Message="@Localizer["RevokePasskeyDangerMessage"]"
                              ConfirmLabel="@Localizer["RevokeFinalConfirmLabel"]" IsBusy="_revoking"
                              OnConfirm="RevokeFido2CredentialAsync" OnCancel="() => _pendingRevokeFido2 = null" />
        }
    }
</ConfirmDialog>

@code {
    private IReadOnlyList<ManagedPerson>? _persons;
    private string? _error;
    private string? _searchError;
    private bool _saving;
    private string _searchTerm = string.Empty;
    private IReadOnlyList<DirectoryUserSearchResult>? _searchResults;
    private ManagedPerson? _pendingDeactivation;
    private ManagedPerson? _pendingReactivation;
    private ConfirmDialog? _createDialog;
    private ConfirmDialog? _mfaDialog;
    private ManagedPerson? _mfaPerson;
    private IReadOnlyList<ManagedTotpFactor>? _mfaFactors;
    private string? _mfaError;
    private bool _mfaLoading;
    private ManagedTotpFactor? _pendingRevoke;
    private IReadOnlyList<ManagedFido2Credential>? _fido2Credentials;
    private ManagedFido2Credential? _pendingRevokeFido2;
    private bool _revoking;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try { _error = null; _persons = await AdministrationClient.GetPersonsAsync(CancellationToken.None); }
        catch { _error = Localizer["LoadPersonsError"]; }
    }

    private async Task OpenCreateDialogAsync()
    {
        _searchTerm = string.Empty; _searchResults = null; _searchError = null;
        StateHasChanged();
        await _createDialog!.ShowAsync();
    }

    private void CloseCreateDialog() { _searchResults = null; _searchError = null; }

    private async Task OpenMfaDialogAsync(ManagedPerson person)
    {
        _mfaPerson = person; _mfaFactors = null; _fido2Credentials = null; _mfaError = null; _pendingRevoke = null; _pendingRevokeFido2 = null; _mfaLoading = true;
        StateHasChanged();
        await _mfaDialog!.ShowAsync();
        await LoadMfaFactorsAsync();
    }

    private void CloseMfaDialog() { _mfaPerson = null; _mfaFactors = null; _fido2Credentials = null; _mfaError = null; _pendingRevoke = null; _pendingRevokeFido2 = null; }

    private async Task LoadMfaFactorsAsync()
    {
        if (_mfaPerson is null) return;
        _mfaLoading = true;
        try
        {
            _mfaFactors = await AdministrationClient.ListTotpFactorsAsync(_mfaPerson.PersonId, CancellationToken.None);
            _fido2Credentials = await AdministrationClient.ListFido2CredentialsAsync(_mfaPerson.PersonId, CancellationToken.None);
        }
        catch { _mfaError = Localizer["LoadMfaFactorsError"]; }
        finally { _mfaLoading = false; }
    }

    private async Task RevokeFactorAsync()
    {
        if (_mfaPerson is null || _pendingRevoke is null) return;
        _revoking = true;
        try { await AdministrationClient.RevokeTotpFactorAsync(_mfaPerson.PersonId, _pendingRevoke, CancellationToken.None); _pendingRevoke = null; await LoadMfaFactorsAsync(); }
        catch { _mfaError = Localizer["RevokeFactorError"]; }
        finally { _revoking = false; }
    }

    private async Task RevokeFido2CredentialAsync()
    {
        if (_mfaPerson is null || _pendingRevokeFido2 is null) return;
        _revoking = true;
        try { await AdministrationClient.RevokeFido2CredentialAsync(_mfaPerson.PersonId, _pendingRevokeFido2, CancellationToken.None); _pendingRevokeFido2 = null; await LoadMfaFactorsAsync(); }
        catch { _mfaError = Localizer["RevokePasskeyError"]; }
        finally { _revoking = false; }
    }

    private string MfaFactorStatus(ManagedTotpFactor factor)
    {
        if (factor.RevokedUtc is not null) return Localizer["RevokedOnLabel", factor.RevokedUtc.Value.ToLocalTime().ToString("g")];
        if (factor.LockedUntilUtc is { } lockedUntilUtc && lockedUntilUtc > DateTimeOffset.UtcNow) return Localizer["LockedUntilLabel", lockedUntilUtc.ToLocalTime().ToString("g")];
        return factor.IsActive ? Localizer["ActiveLabel"] : Localizer["NotConfirmedLabel"];
    }

    private async Task SearchAsync()
    {
        if (_searchTerm.Trim().Length < 2) { _searchError = Localizer["SearchMinLengthError"]; return; }
        _saving = true;
        try
        {
            _searchError = null;
            _searchResults = await AdministrationClient.SearchDirectoryUsersAsync(_searchTerm, CancellationToken.None);
            if (_searchResults.Count == 0) _searchError = Localizer["NoMatchingPersonError"];
        }
        catch { _searchError = Localizer["SearchFailedError"]; }
        finally { _saving = false; }
    }

    private async Task OnboardAsync(DirectoryUserSearchResult user)
    {
        _saving = true;
        try
        {
            await AdministrationClient.CreatePersonFromDirectoryAccountAsync(user.ObjectGuid, CancellationToken.None);
            await _createDialog!.HideAsync();
            await LoadAsync();
        }
        catch { _searchError = Localizer["OnboardAccountError"]; }
        finally { _saving = false; }
    }

    private async Task SetActiveAsync(bool active)
    {
        var person = active ? _pendingReactivation : _pendingDeactivation;
        if (person is null) return;
        _saving = true;
        try { await AdministrationClient.SetPersonActiveAsync(person, active, CancellationToken.None); _pendingDeactivation = null; _pendingReactivation = null; await LoadAsync(); }
        catch { _error = Localizer["SetPersonActiveError"]; }
        finally { _saving = false; }
    }
}

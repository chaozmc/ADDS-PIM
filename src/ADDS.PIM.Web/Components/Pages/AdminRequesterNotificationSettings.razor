@page "/admin/settings/notification-requester"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminRequesterNotificationSettings> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject ILogger<AdminRequesterNotificationSettings> Logger

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["Heading"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_form is null)
{
    <LoadingIndicator Message="@Localizer["LoadingMessage"]" />
}
else
{
    @if (_error is not null)
    {
        <p class="submission-result failed" role="alert">@_error</p>
    }
    @if (_success is not null)
    {
        <p class="submission-result succeeded" role="status">@_success</p>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="card">
            <div class="card-body">
                <h2 class="h4">@Localizer["PolicyHeading"]</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="cc-address">@Localizer["CcAddressLabel"]</label>
                        <InputText id="cc-address" class="form-control" @bind-Value="_form.CcAddress" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="bcc-address">@Localizer["BccAddressLabel"]</label>
                        <InputText id="bcc-address" class="form-control" @bind-Value="_form.BccAddress" />
                    </div>
                </div>
                <p class="mt-3">
                    <button class="btn btn-primary" type="submit" disabled="@_saving">@SharedLocalizer["SaveButton"]</button>
                </p>
            </div>
        </div>
    </EditForm>
}

@code {
    private FormModel? _form;
    private string? _rowVersion;
    private bool _saving;
    private string? _error;
    private string? _success;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            var snapshot = await AdministrationClient.GetRequesterNotificationSettingsAsync(CancellationToken.None);
            _rowVersion = snapshot.Configured ? snapshot.RowVersion : null;
            _form = new FormModel { CcAddress = snapshot.CcAddress, BccAddress = snapshot.BccAddress };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load requester notification settings.");
            _error = Localizer["LoadError"];
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        _saving = true;
        try
        {
            _error = null; _success = null;
            await AdministrationClient.UpsertRequesterNotificationSettingsAsync(_form.CcAddress, _form.BccAddress, _rowVersion, CancellationToken.None);
            _success = Localizer["SaveSuccessMessage"];
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save requester notification settings.");
            _error = Localizer["SaveError"];
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string? CcAddress { get; set; }

        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string? BccAddress { get; set; }
    }
}

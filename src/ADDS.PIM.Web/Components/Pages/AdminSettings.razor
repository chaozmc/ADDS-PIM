@page "/admin/settings"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AdminSettings> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["Heading"]</h1>
        <p>@Localizer["IntroText"]</p>
    </div>
</section>

<section class="row g-3" aria-label="@Localizer["SettingsAreasAriaLabel"]">
    <div class="col-md-6">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-ticket-perforated-fill" style="color: var(--pim-primary);" aria-hidden="true"></i> @Localizer["TicketPatternsTitle"]</h2>
                <p>@Localizer["TicketPatternsDescription"]</p>
                <a class="btn btn-primary" href="/admin/settings/ticket-reference-patterns">@Localizer["TicketPatternsLinkText"]</a>
            </div>
        </article>
    </div>
    <div class="col-md-6">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-shield-lock-fill" style="color: var(--pim-primary);" aria-hidden="true"></i> @Localizer["TotpCertificateTitle"]</h2>
                <p>@Localizer["TotpCertificateDescription"]</p>
                <a class="btn btn-primary" href="/admin/settings/totp-protection-certificate">@Localizer["TotpCertificateLinkText"]</a>
            </div>
        </article>
    </div>
    <div class="col-md-6">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-envelope-fill" style="color: var(--pim-primary);" aria-hidden="true"></i> @Localizer["MailSettingsTitle"]</h2>
                <p>@Localizer["MailSettingsDescription"]</p>
                <a class="btn btn-primary" href="/admin/settings/mail">@Localizer["MailSettingsLinkText"]</a>
            </div>
        </article>
    </div>
    <div class="col-md-6">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-envelope-at-fill" style="color: var(--pim-primary);" aria-hidden="true"></i> @Localizer["NotificationRecipientsTitle"]</h2>
                <p>@Localizer["NotificationRecipientsDescription"]</p>
                <a class="btn btn-primary" href="/admin/settings/notification-recipients">@Localizer["NotificationRecipientsLinkText"]</a>
            </div>
        </article>
    </div>
    <div class="col-md-6">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-file-earmark-text-fill" style="color: var(--pim-primary);" aria-hidden="true"></i> @Localizer["NotificationTemplatesTitle"]</h2>
                <p>@Localizer["NotificationTemplatesDescription"]</p>
                <a class="btn btn-primary" href="/admin/settings/notification-templates">@Localizer["NotificationTemplatesLinkText"]</a>
            </div>
        </article>
    </div>
    <div class="col-md-6">
        <article class="card h-100">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-person-lines-fill" style="color: var(--pim-primary);" aria-hidden="true"></i> @Localizer["RequesterNotificationTitle"]</h2>
                <p>@Localizer["RequesterNotificationDescription"]</p>
                <a class="btn btn-primary" href="/admin/settings/notification-requester">@Localizer["RequesterNotificationLinkText"]</a>
            </div>
        </article>
    </div>
</section>

@page "/admin/technical-errors"
@using Microsoft.Extensions.Localization
@using ADDS.PIM.Web.Components.Shared
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminTechnicalErrors> Localizer
@inject IStringLocalizer<SharedResources> SharedLocalizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["Heading"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_error is not null)
{
    <p class="submission-result failed" role="alert">@_error</p>
}
else if (_page is null)
{
    <LoadingIndicator Message="@Localizer["LoadingMessage"]" />
}
else
{
    <EditForm class="row g-3 mt-2" Model="_filters" OnValidSubmit="ApplyFiltersAsync">
        <div class="col-md-3">
            <label for="error-request-id" class="form-label">@Localizer["RequestIdLabel"]</label>
            <InputText id="error-request-id" class="form-control" @bind-Value="_filters.RequestId" placeholder="@Localizer["RequestIdPlaceholder"]" />
        </div>
        <div class="col-md-2">
            <label for="error-from" class="form-label">@Localizer["FromLabel"]</label>
            <InputDate id="error-from" class="form-control" @bind-Value="_filters.FromLocalDate" />
        </div>
        <div class="col-md-2">
            <label for="error-to" class="form-label">@Localizer["ToLabel"]</label>
            <InputDate id="error-to" class="form-control" @bind-Value="_filters.ToLocalDate" />
        </div>
        <div class="col-md-2">
            <label for="error-page-size" class="form-label">@Localizer["PageSizeLabel"]</label>
            <InputSelect id="error-page-size" class="form-select" @bind-Value="_filters.PageSize">
                @foreach (var pageSize in PageSizes)
                {
                    <option value="@pageSize">@pageSize</option>
                }
            </InputSelect>
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> @Localizer["FilterButton"]</button>
        </div>
    </EditForm>

    @if (_filterError is not null)
    {
        <p class="submission-result failed" role="alert">@_filterError</p>
    }

    @if (_page.TotalCount == 0)
    {
        <EmptyState Icon="bi-bug" Title="@Localizer["EmptyTitle"]" Description="@Localizer["EmptyDescription"]" />
    }
    else
    {
        <div class="table-responsive mt-3" role="region" aria-label="@Localizer["TableAriaLabel"]" tabindex="0">
            <table class="table table-sm">
                <thead>
                    <tr><th>@Localizer["ColTimestamp"]</th><th>@Localizer["ColMethod"]</th><th>@Localizer["ColPath"]</th><th>@Localizer["ColExceptionType"]</th><th>@Localizer["RequestIdLabel"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in _page.Items)
                    {
                        var expanded = _expandedErrorId == entry.ErrorId;
                        <tr role="button" tabindex="0" aria-expanded="@expanded" @onclick="() => ToggleDetails(entry.ErrorId)">
                            <td><i class="bi @(expanded ? "bi-chevron-down" : "bi-chevron-right") text-muted me-1" aria-hidden="true"></i>@entry.OccurredUtc.UtcDateTime.ToString("u")</td>
                            <td>@entry.HttpMethod</td>
                            <td>@entry.Path</td>
                            <td>@entry.ExceptionType</td>
                            <td><code>@(entry.RequestId?.ToString() ?? "—")</code></td>
                        </tr>
                        @if (expanded)
                        {
                            <tr>
                                <td colspan="5">
                                    <dl class="row mb-0">
                                        <div class="col-md-4"><dt>@Localizer["DtErrorId"]</dt><dd><code>@entry.ErrorId</code></dd></div>
                                        <div class="col-md-4"><dt>@Localizer["DtRequestId"]</dt><dd><code>@(entry.RequestId?.ToString() ?? "—")</code></dd></div>
                                        <div class="col-md-4"><dt>@Localizer["DtCorrelationId"]</dt><dd><code>@(entry.CorrelationId?.ToString() ?? "—")</code></dd></div>
                                        <div class="col-md-4"><dt>@Localizer["DtStatusCode"]</dt><dd>@(entry.StatusCode?.ToString() ?? "—")</dd></div>
                                        <div class="col-md-4"><dt>@Localizer["DtSourceComponent"]</dt><dd>@entry.SourceComponent</dd></div>
                                        <div class="col-12"><dt>@Localizer["DtMessage"]</dt><dd>@entry.Message</dd></div>
                                        <div class="col-12"><dt>@Localizer["DtStackTrace"]</dt><dd><pre class="mb-0">@entry.StackTrace</pre></dd></div>
                                    </dl>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <nav class="d-flex justify-content-between align-items-center mt-2" aria-label="@Localizer["PaginationAriaLabel"]">
            <button type="button" class="btn btn-secondary" @onclick="PreviousPageAsync" disabled="@(_filters.PageNumber == 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> @SharedLocalizer["BackButton"]</button>
            <span>@Localizer["PageStatus", _filters.PageNumber, PageCount, _page.TotalCount]</span>
            <button type="button" class="btn btn-secondary" @onclick="NextPageAsync" disabled="@(_filters.PageNumber >= PageCount)">@Localizer["NextButton"] <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </nav>
    }
}

@code {
    private static readonly int[] PageSizes = [10, 20, 30, 40, 50];
    private readonly TechnicalErrorFilters _filters = new();
    private TechnicalErrorLogPage? _page;
    private Guid? _expandedErrorId;
    private string? _error;
    private string? _filterError;

    private int PageCount => _page is null ? 1 : Math.Max(1, (int)Math.Ceiling(_page.TotalCount / (decimal)_filters.PageSize));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ApplyFiltersAsync()
    {
        _filters.PageNumber = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        _filters.PageNumber--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        _filters.PageNumber++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _filterError = null;
        _expandedErrorId = null;

        Guid? requestId = null;
        if (!string.IsNullOrWhiteSpace(_filters.RequestId))
        {
            if (!Guid.TryParse(_filters.RequestId, out var parsedRequestId))
            {
                _filterError = Localizer["InvalidRequestIdError"];
                _page ??= new([], 0);
                return;
            }
            requestId = parsedRequestId;
        }

        try
        {
            _page = await AdministrationClient.GetTechnicalErrorsAsync(
                _filters.PageNumber,
                _filters.PageSize,
                _filters.FromLocalDate is { } from ? new DateTimeOffset(from, TimeZoneInfo.Local.GetUtcOffset(from)) : null,
                _filters.ToLocalDate is { } to ? new DateTimeOffset(to.AddDays(1), TimeZoneInfo.Local.GetUtcOffset(to)).AddTicks(-1) : null,
                requestId,
                null,
                CancellationToken.None);
        }
        catch
        {
            _error = Localizer["LoadError"];
        }
    }

    private void ToggleDetails(Guid errorId) => _expandedErrorId = _expandedErrorId == errorId ? null : errorId;

    private sealed class TechnicalErrorFilters
    {
        public int PageNumber { get; set; } = 1;
        public int PageSize { get; set; } = 20;
        public string? RequestId { get; set; }
        public DateTime? FromLocalDate { get; set; }
        public DateTime? ToLocalDate { get; set; }
    }
}

@page "/admin/settings/totp-protection-certificate"
@using Microsoft.Extensions.Localization
@inject IAdministrationClient AdministrationClient
@inject IStringLocalizer<AdminTotpProtectionCertificate> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <h1>@Localizer["Heading"]</h1>
        <p>@Localizer["HeroDescription"]</p>
    </div>
</section>

@if (_status is null)
{
    <LoadingIndicator Message="@Localizer["StatusLoading"]" />
}
else
{
    <section aria-labelledby="status-title" class="mt-4">
        <h2 id="status-title">@Localizer["CurrentStatusHeading"]</h2>
        @if (!_status.Found)
        {
            <div class="card border-danger">
                <div class="card-body">
                    <StatusBadge Text="@Localizer["NotFoundBadge"]" Variant="StatusBadge.BadgeVariant.Danger" />
                    <p class="mt-2 mb-0">@Localizer["NotFoundMessage", _status.Thumbprint]</p>
                </div>
            </div>
        }
        else
        {
            <div class="card @(IsExpiringSoon ? "border-danger" : "border-success")">
                <div class="card-body">
                    <StatusBadge Text="@StatusText" Variant="@StatusVariant" />
                    <dl class="row mt-3 mb-0">
                        <dt class="col-sm-4">Thumbprint</dt>
                        <dd class="col-sm-8"><code>@_status.Thumbprint</code></dd>
                        <dt class="col-sm-4">@Localizer["ValidUntilLabel"]</dt>
                        <dd class="col-sm-8">@_status.NotAfter?.ToString("u") (@DaysRemainingText)</dd>
                        <dt class="col-sm-4">@Localizer["PrivateKeyAccessibleLabel"]</dt>
                        <dd class="col-sm-8">@(_status.PrivateKeyAccessible ? Localizer["Yes"] : Localizer["No"])</dd>
                        <dt class="col-sm-4">@Localizer["ProtectedFactorsLabel"]</dt>
                        <dd class="col-sm-8">@Localizer["ProtectedFactorsValue", _status.ActiveFactorsProtected, _status.TotalFactorsProtected]</dd>
                    </dl>
                </div>
            </div>
        }
    </section>

    <section class="mt-4" aria-labelledby="rotate-title">
        <h2 id="rotate-title">@Localizer["RolloverHeading"]</h2>
        <p>
            @Localizer["RolloverDescription"]
        </p>

        @if (_error is not null)
        {
            <p class="submission-result failed" role="alert">@_error</p>
        }
        @if (_success is not null)
        {
            <p class="submission-result succeeded" role="status">@_success</p>
        }

        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-8">
                <label class="form-label" for="incoming-thumbprint">@Localizer["NewCertificateThumbprintLabel"]</label>
                <input id="incoming-thumbprint" class="form-control" @bind="_incomingThumbprint" @bind:event="oninput" placeholder="@Localizer["ThumbprintPlaceholder"]" />
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_incomingThumbprint))
        {
            <DangerZonePanel Message="@Localizer["RolloverConfirmationMessage", ExpectedConfirmation]"
                              ConfirmLabel="@Localizer["ExecuteRolloverButton"]" IsBusy="_loading" CanConfirm="@(_confirmation == ExpectedConfirmation)"
                              OnConfirm="ExecuteAsync" OnCancel="() => _confirmation = string.Empty">
                <input class="form-control" @bind="_confirmation" @bind:event="oninput" aria-label="Rotation confirmation" placeholder="@ExpectedConfirmation" />
                @if (!string.IsNullOrEmpty(_confirmation) && _confirmation != ExpectedConfirmation)
                {
                    <div class="form-text text-danger">@Localizer["ConfirmationMismatch", ExpectedConfirmation]</div>
                }
            </DangerZonePanel>
        }
    </section>
}

@code {
    private TotpProtectionCertificateStatus? _status;
    private string _incomingThumbprint = string.Empty;
    private string _confirmation = string.Empty;
    private bool _loading;
    private string? _error;
    private string? _success;

    private const int WarningThresholdDays = 30;

    private string ExpectedConfirmation => $"ROTATE {_incomingThumbprint.Trim()}";

    private bool IsExpiringSoon => _status is { Found: true, NotAfter: not null } && (_status.NotAfter.Value - DateTimeOffset.UtcNow).TotalDays <= WarningThresholdDays;

    private StatusBadge.BadgeVariant StatusVariant => _status is null ? StatusBadge.BadgeVariant.Neutral : IsExpiringSoon ? StatusBadge.BadgeVariant.Danger : StatusBadge.BadgeVariant.Success;

    private string StatusText => _status is null ? string.Empty : IsExpiringSoon ? Localizer["ExpiringSoonStatus", DaysRemainingText] : Localizer["ValidStatus", DaysRemainingText];

    private string DaysRemainingText
    {
        get
        {
            if (_status?.NotAfter is null) return Localizer["UnknownValue"];
            var days = (int)Math.Floor((_status.NotAfter.Value - DateTimeOffset.UtcNow).TotalDays);
            return days < 0 ? Localizer["DaysExpiredAgo", -days] : Localizer["DaysRemaining", days];
        }
    }

    protected override async Task OnInitializedAsync() => await LoadStatusAsync();

    private async Task LoadStatusAsync()
    {
        try { _error = null; _status = await AdministrationClient.GetTotpProtectionCertificateStatusAsync(CancellationToken.None); }
        catch { _error = Localizer["LoadStatusError"]; }
    }

    private async Task ExecuteAsync()
    {
        _loading = true;
        try
        {
            _error = null; _success = null;
            await AdministrationClient.RotateTotpProtectionCertificateAsync(_incomingThumbprint.Trim(), _confirmation, CancellationToken.None);
            _success = Localizer["RolloverSuccessMessage"];
            _incomingThumbprint = string.Empty; _confirmation = string.Empty;
            await LoadStatusAsync();
        }
        catch { _error = Localizer["RolloverFailureMessage"]; }
        finally { _loading = false; }
    }
}

@page "/mfa/totp/enroll"
@using Microsoft.Extensions.Localization
@inject IOperatorRequestClient RequestClient
@inject IStringLocalizer<EnrollTotp> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="page-header">
    <section class="hero" aria-labelledby="page-title">
        <div>
            <p class="eyebrow">@Localizer["Eyebrow"]</p>
            <h1 id="page-title">@Localizer["Heading"]</h1>
            <p>@Localizer["IntroText"]</p>
        </div>
    </section>
    <NavLink class="back-link" href="/mfa"><i class="bi bi-arrow-left" aria-hidden="true"></i> @Localizer["BackToOverviewLink"]</NavLink>
</div>

@if (_loadingStatus)
{
    <LoadingIndicator Message="@Localizer["LoadingStatusMessage"]" />
}
else if (_error is not null)
{
    <div class="submission-result failed" role="alert">@_error</div>
}
else if (_confirmed || _alreadyEnrolled)
{
    <div class="submission-result accepted" role="status">
        <h3>@Localizer["FactorSetUpHeading"]</h3>
        <p>
            @if (_confirmed)
            {
                <text>@Localizer["FactorActiveMessage"]</text>
            }
            else
            {
                <text>@Localizer["AlreadyEnrolledMessage"]</text>
            }
        </p>
        <NavLink href="/mfa">@Localizer["BackToOverviewLink"]</NavLink>
    </div>
}
else if (_enrollment is null)
{
    <section class="request-form" aria-labelledby="start-title">
        <h2 id="start-title">@Localizer["StartFactorHeading"]</h2>
        <p>@Localizer["StartFactorIntro"]</p>
        <button class="submit-button" type="button" disabled="@_starting" @onclick="StartEnrollmentAsync">@(_starting ? Localizer["GeneratingBusyButton"] : Localizer["GenerateFactorButton"])</button>
    </section>
}
else
{
    <section class="request-form" aria-labelledby="confirm-title">
        <h2 id="confirm-title">@Localizer["StoreInAuthenticatorHeading"]</h2>
        <p>@Localizer["ScanQrCodeInstruction"]</p>
        <div class="totp-qr-code" role="img" aria-label="@Localizer["QrCodeAriaLabel"]">
            @((MarkupString)_qrCodeSvg!)
        </div>
        <div class="field">
            <label for="manual-secret">@Localizer["ManualEntryLabel"]</label>
            <input id="manual-secret" type="text" readonly value="@FormatSecretForDisplay(_enrollment.Secret)" class="totp-manual-secret" />
            <span class="hint">@Localizer["AccountTypeHint"]</span>
        </div>
        <EditForm Model="_confirmForm" OnValidSubmit="ConfirmAsync">
            <div class="field">
                <label for="confirm-code">@Localizer["ConfirmCodeLabel"]</label>
                <InputText id="confirm-code" @bind-Value="_confirmForm.Code" autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
            </div>
            @if (_confirmError is not null)
            {
                <div class="submission-result failed" role="alert">@_confirmError</div>
            }
            <button class="submit-button" type="submit" disabled="@_confirming">@(_confirming ? Localizer["ConfirmingBusyButton"] : Localizer["ConfirmFactorButton"])</button>
        </EditForm>
        <p class="hint">@Localizer["EnrollmentExpiresLabel"] @_enrollment.ExpiresUtc.ToLocalTime().ToString("t")</p>
    </section>
}

@code {
    private readonly ConfirmForm _confirmForm = new();
    private TotpEnrollmentStarted? _enrollment;
    private string? _qrCodeSvg;
    private string? _error;
    private string? _confirmError;
    private bool _starting, _confirming, _confirmed, _alreadyEnrolled;
    private bool _loadingStatus = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await RequestClient.GetMfaStatusAsync(CancellationToken.None);
            _alreadyEnrolled = status?.TotpEnrolled ?? false;
        }
        catch { _error = Localizer["StatusLoadError"]; }
        finally { _loadingStatus = false; }
    }

    private async Task StartEnrollmentAsync()
    {
        _starting = true; _error = null;
        try
        {
            _enrollment = await RequestClient.EnrollTotpFactorAsync(CancellationToken.None);
            if (_enrollment is null) { _alreadyEnrolled = true; return; }
            _qrCodeSvg = GenerateQrCodeSvg(_enrollment.ProvisioningUri);
        }
        catch { _error = Localizer["FactorGenerationError"]; }
        finally { _starting = false; }
    }

    private static string GenerateQrCodeSvg(string content)
    {
        using var generator = new QRCoder.QRCodeGenerator();
        using var data = generator.CreateQrCode(content, QRCoder.QRCodeGenerator.ECCLevel.Q);
        var svgQrCode = new QRCoder.SvgQRCode(data);
        // ViewBoxAttribute renders only a "viewBox" (no fixed width/height) so the CSS width:100%/height:auto
        // below rescales the whole graphic responsively. The default WidthHeightAttribute mode emits fixed
        // pixel width/height with no viewBox at all - shrinking that via CSS clips the coordinate space
        // instead of rescaling it, which is what caused the QR code to render cropped.
        return svgQrCode.GetGraphic(6, System.Drawing.Color.Black, System.Drawing.Color.White, drawQuietZones: true, sizingMode: QRCoder.SvgQRCode.SizingMode.ViewBoxAttribute);
    }

    private static string FormatSecretForDisplay(string secret)
        => string.Join(' ', Enumerable.Range(0, (secret.Length + 3) / 4).Select(i => secret.Substring(i * 4, Math.Min(4, secret.Length - i * 4))));

    private async Task ConfirmAsync()
    {
        if (_enrollment is null || string.IsNullOrWhiteSpace(_confirmForm.Code)) return;
        _confirming = true; _confirmError = null;
        try
        {
            _confirmed = await RequestClient.ConfirmTotpEnrollmentAsync(_enrollment.TotpFactorId, _confirmForm.Code, CancellationToken.None);
            if (!_confirmed) _confirmError = Localizer["InvalidOrExpiredCodeError"];
        }
        catch { _confirmError = Localizer["CodeConfirmError"]; }
        finally { _confirming = false; }
    }

    private sealed class ConfirmForm { public string Code { get; set; } = string.Empty; }
}

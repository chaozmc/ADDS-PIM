@page "/Error"
@layout MainLayout
@using System.Diagnostics
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Error> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">@Localizer["ErrorEyebrow"]</p>
        <h1>@Localizer["ErrorHeading"]</h1>
        <p>@Localizer["ErrorMessage"]</p>
    </div>
</section>

<div class="submission-result failed" role="alert">
    @if (ShowRequestId)
    {
        <p><strong>@Localizer["RequestIdLabel"]</strong> <code>@RequestId</code></p>
    }
    else
    {
        <p>@Localizer["NoRequestIdMessage"]</p>
    }
</div>

<NavLink class="btn btn-secondary mt-3" href="">@Localizer["BackToHomeLink"]</NavLink>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

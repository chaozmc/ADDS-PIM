@page "/new-request"
@inject IOperatorRequestClient RequestClient
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS

<Fido2Interop />

<PageTitle>ADDS-PIM · Gruppenberechtigung anfordern</PageTitle>

<section class="hero" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">Privileged access</p>
        <h1 id="page-title">Meine Gruppenberechtigungen</h1>
        <p>Wählen Sie eine aktuell für Ihr Zielkonto berechtigte Gruppe. Die Berechtigung und Richtlinie werden vor der AD-Änderung erneut geprüft.</p>
    </div>
</section>

@if (_loading)
{
    <LoadingIndicator Message="Berechtigungen werden geladen …" />
}
else if (_error is not null)
{
    <div class="submission-result failed" role="alert"><p>@_error</p>@if (_showEnrollLink) { <p><NavLink href="/mfa/totp/enroll">Faktor einrichten</NavLink></p> }@if (_failedRequestId is not null) { <p>Request-ID: <code>@_failedRequestId</code></p> }</div>
}
else if (_entitlements.Count == 0)
{
    <div class="prototype-notice" role="status"><strong>Keine aktiven Berechtigungen</strong><span>Für Ihr Konto ist derzeit kein aktives Entitlement hinterlegt.</span></div>
}
else if (_pendingSecondFactor is not null)
{
    <section class="request-form" aria-labelledby="second-factor-title">
        <h2 id="second-factor-title">Zweiten Faktor bestätigen</h2>
        <p>Bestätigen Sie die folgende Anfrage mit einem TOTP-Code, um die zeitlich begrenzte Gruppenmitgliedschaft auszuführen.</p>
        <dl class="second-factor-summary">
            <dt>Actor-Konto</dt><dd>@_windowsIdentity</dd>
            <dt>Zielkonto</dt><dd>@Selected?.TargetAccountDisplayName</dd>
            <dt>Gruppe</dt><dd>@Selected?.TargetGroupDisplayName</dd>
            <dt>Gültig bis</dt><dd>@_pendingSecondFactor.ExpiresUtc.ToLocalTime().ToString("t")</dd>
        </dl>
        @if (_secondFactorError is not null)
        {
            <div class="submission-result failed" role="alert">@_secondFactorError</div>
        }
        @{ var allowedTypes = Selected?.AllowedSecondFactorTypes ?? 3; }
        @if ((allowedTypes & 1) != 0)
        {
            <button class="submit-button" type="button" disabled="@_verifyingSecondFactor" @onclick="VerifyFido2SecondFactorAsync">@(_verifyingSecondFactor ? "Wird geprüft …" : "Mit Passkey bestätigen")</button>
        }
        @if ((allowedTypes & 2) != 0)
        {
            @if (_mfaStatus is { TotpEnrolled: false })
            {
                <div class="submission-result failed" role="alert">
                    <p>Für Ihr Konto ist noch kein TOTP-Faktor eingerichtet. Richten Sie zuerst einen Faktor ein, um diesen Request zu bestätigen.</p>
                    <NavLink href="/mfa/totp/enroll">Faktor einrichten</NavLink>
                </div>
            }
            else
            {
                <EditForm Model="_secondFactorForm" OnValidSubmit="VerifySecondFactorAsync">
                    <div class="field">
                        <label for="totp-code">TOTP-Code</label>
                        <InputText id="totp-code" @bind-Value="_secondFactorForm.Code" autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
                    </div>
                    <button class="submit-button" type="submit" disabled="@_verifyingSecondFactor">@(_verifyingSecondFactor ? "Wird geprüft …" : "Bestätigen und ausführen")</button>
                </EditForm>
            }
        }
    </section>
}
else
{
    <section class="request-form" aria-labelledby="form-title">
        <h2 id="form-title">Berechtigung anfordern</h2>
        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="field">
                <label for="entitlement">Gruppe und Zielkonto</label>
                <InputSelect id="entitlement" @bind-Value="_form.EntitlementId" @bind-Value:after="SelectEntitlement">
                    @foreach (var item in _entitlements)
                    {
                        <option value="@item.EntitlementId">@item.TargetGroupDisplayName · @item.TargetAccountDisplayName@DisplayRestriction(item)</option>
                    }
                </InputSelect>
            </div>
            @if (Selected is not null)
            {
                <div class="field">
                    <label for="duration">Dauer</label>
                    <InputSelect id="duration" @bind-Value="_form.RequestedTtlSeconds">
                        @foreach (var seconds in Durations(Selected))
                        {
                            <option value="@seconds">@FormatDuration(seconds)</option>
                        }
                    </InputSelect>
                    <span class="hint">Erlaubt: @FormatDuration(Selected.MinimumTtlSeconds) bis @FormatDuration(Selected.MaximumTtlSeconds), in Schritten von @FormatDuration(Selected.TtlStepSeconds).</span>
                </div>
                <div class="field">
                    <label for="reason">Begründung <span aria-hidden="true">*</span></label>
                    <textarea id="reason" @bind="_form.Reason" @bind:event="oninput" rows="5"></textarea>
                </div>
                @if (Selected.RequiresTicket)
                {
                    <div class="field"><label for="ticket">Ticket-Referenz <span aria-hidden="true">*</span></label><InputText id="ticket" @bind-Value="_form.TicketReference" /></div>
                }
                @if (Selected.RequiresSecondFactor)
                {
                    <p class="hint">Für diese Gruppe ist ein zweiter Faktor (@SecondFactorLabel(Selected.AllowedSecondFactorTypes)) erforderlich. Sie werden nach dem Absenden zur Bestätigung aufgefordert.</p>
                }
                @if (Selected.RequiresApproval)
                {
                    <p class="hint">Für diese Gruppe ist eine Genehmigung erforderlich. Der Request wartet nach dem Absenden auf die Entscheidung eines zugeordneten Approvers.</p>
                }
                <button class="submit-button" type="submit" disabled="@_submitting">@(_submitting ? "Request wird ausgeführt …" : "Zeitlich begrenzten Zugriff anfordern")</button>
            }
        </EditForm>
        @if (_result is not null) { <div class="request-status-panel submission-result @ResultVariant(_result.Status)" role="status"><h3>Status: @_result.Status</h3>@if (!string.IsNullOrWhiteSpace(_result.OutcomeMessage)) { <p>@_result.OutcomeMessage</p> }<p>Request-ID: <code class="@(_result.Status == "Succeeded" ? "request-id-success" : null)">@_result.RequestId</code></p></div> }
    </section>
}

@code {
    private readonly RequestForm _form = new();
    private readonly SecondFactorForm _secondFactorForm = new();
    private IReadOnlyList<MyAvailableMembershipEntitlement> _entitlements = [];
    private MembershipRequestAccepted? _result;
    private MembershipRequestPendingSecondFactor? _pendingSecondFactor;
    private MyMfaStatusResponse? _mfaStatus;
    private string? _error;
    private string? _secondFactorError;
    private string? _windowsIdentity;
    private Guid? _failedRequestId;
    private bool _showEnrollLink;
    private bool _loading = true, _submitting, _verifyingSecondFactor;
    private MyAvailableMembershipEntitlement? Selected => _entitlements.SingleOrDefault(item => item.EntitlementId == _form.EntitlementId);

    protected override async Task OnInitializedAsync()
    {
        _windowsIdentity = HttpContextAccessor.HttpContext?.User.Identity?.Name;
        try { _entitlements = await RequestClient.ListAvailableEntitlementsAsync(CancellationToken.None); if (_entitlements.Count > 0) SelectEntitlement(); }
        catch { _error = "Ihre Berechtigungen konnten nicht geladen werden. Prüfen Sie die geschützten Serverprotokolle mit der Request-ID."; }
        finally { _loading = false; }
        try { _mfaStatus = await RequestClient.GetMfaStatusAsync(CancellationToken.None); }
        catch { _mfaStatus = null; }
    }

    private void SelectEntitlement()
    {
        var item = Selected ?? _entitlements[0]; _form.EntitlementId = item.EntitlementId; _form.RequestedTtlSeconds = item.DefaultTtlSeconds; _form.TicketReference = string.Empty;
    }
    private void ResetFormAfterCompletion()
    {
        _form.Reason = string.Empty;
        SelectEntitlement();
    }
    private async Task SubmitAsync()
    {
        var item = Selected; if (item is null) return;
        if (item.RequiresTicket && string.IsNullOrWhiteSpace(_form.TicketReference)) { _error = "Für diese Gruppe ist eine Ticket-Referenz erforderlich."; return; }
        _submitting = true; _error = null; _failedRequestId = null; _showEnrollLink = false; _result = null;
        try
        {
            var submission = await RequestClient.SubmitAsync(item.TargetAccountId, item.TargetGroupId, _form.RequestedTtlSeconds, _form.Reason, _form.TicketReference, CancellationToken.None);
            if (submission.PendingSecondFactor is not null) { _pendingSecondFactor = submission.PendingSecondFactor; _secondFactorForm.Code = string.Empty; }
            else { _result = submission.Accepted; ResetFormAfterCompletion(); }
        }
        catch (MembershipRequestSubmissionException exception)
        {
            _failedRequestId = exception.RequestId;
            if (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity && exception.ProblemTitle == "No active second factor is enrolled for this account.")
            {
                var allowsTotp = (item.AllowedSecondFactorTypes & 2) != 0;
                _error = $"Für Ihr Konto ist noch kein aktiver Faktor eingerichtet, der für diese Gruppe zulässig ist ({SecondFactorLabel(item.AllowedSecondFactorTypes)}).{(allowsTotp ? " Richten Sie zuerst einen Faktor ein, bevor Sie diesen Request stellen." : " FIDO2 ist aktuell noch nicht verfügbar; Sie können diesen Request derzeit nicht selbst abschließen.")}";
                _showEnrollLink = allowsTotp;
            }
            else if (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity)
            {
                _error = "Die Ticket-Referenz entspricht keinem für diese Gruppe konfigurierten Pattern.";
            }
            else
            {
                _error = "Der Request konnte nicht ausgeführt werden. Geben Sie die Request-ID bei einer Prüfung an.";
            }
        }
        catch { _error = "Der Request konnte nicht ausgeführt werden. Prüfen Sie die geschützten Serverprotokolle."; }
        finally { _submitting = false; }
    }
    private async Task VerifySecondFactorAsync()
    {
        if (_pendingSecondFactor is null || string.IsNullOrWhiteSpace(_secondFactorForm.Code)) return;
        _verifyingSecondFactor = true; _secondFactorError = null;
        try
        {
            _result = await RequestClient.VerifyTotpSecondFactorAsync(_pendingSecondFactor.RequestId, _secondFactorForm.Code, CancellationToken.None);
            _pendingSecondFactor = null;
            ResetFormAfterCompletion();
        }
        catch (MembershipRequestSubmissionException exception)
        {
            _secondFactorError = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.TooManyRequests => "Der Faktor ist vorübergehend gesperrt. Versuchen Sie es später erneut.",
                System.Net.HttpStatusCode.Conflict => "Die Bestätigung ist abgelaufen oder ungültig. Stellen Sie den Request erneut.",
                System.Net.HttpStatusCode.NotFound => "Es wurde keine ausstehende Bestätigung für diesen Request gefunden.",
                _ => "Der Code konnte nicht bestätigt werden."
            };
        }
        catch { _secondFactorError = "Der Code konnte nicht bestätigt werden. Prüfen Sie die geschützten Serverprotokolle."; }
        finally { _verifyingSecondFactor = false; }
    }
    private async Task VerifyFido2SecondFactorAsync()
    {
        if (_pendingSecondFactor is null) return;
        _verifyingSecondFactor = true; _secondFactorError = null;
        try
        {
            var options = await RequestClient.GetFido2AssertionOptionsAsync(_pendingSecondFactor.RequestId, CancellationToken.None);
            var assertionJson = await JS.InvokeAsync<string>("pimFido2.authenticate", options.OptionsJson);
            _result = await RequestClient.VerifyFido2SecondFactorAsync(_pendingSecondFactor.RequestId, assertionJson, CancellationToken.None);
            _pendingSecondFactor = null;
            ResetFormAfterCompletion();
        }
        catch (MembershipRequestSubmissionException exception)
        {
            _secondFactorError = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.Conflict => "Die Bestätigung ist abgelaufen oder ungültig. Stellen Sie den Request erneut.",
                System.Net.HttpStatusCode.NotFound => "Es wurde keine ausstehende Bestätigung für diesen Request gefunden.",
                _ => "Der Passkey konnte nicht bestätigt werden."
            };
        }
        catch { _secondFactorError = "Der Passkey konnte nicht bestätigt werden."; }
        finally { _verifyingSecondFactor = false; }
    }
    private static string SecondFactorLabel(int allowedSecondFactorTypes) => allowedSecondFactorTypes switch
    {
        1 => "FIDO2",
        2 => "TOTP",
        3 => "TOTP oder FIDO2",
        _ => "ein zweiter Faktor"
    };
    private static IEnumerable<long> Durations(MyAvailableMembershipEntitlement item) { for (var value = item.MinimumTtlSeconds; value <= item.MaximumTtlSeconds; value += item.TtlStepSeconds) yield return value; }
    private static string ResultVariant(string status) => status switch
    {
        "Succeeded" => "accepted",
        "AwaitingApproval" => "pending",
        _ => "failed"
    };
    private static string DisplayRestriction(MyAvailableMembershipEntitlement item)
    {
        var requirements = new List<string>();
        if (item.RequiresSecondFactor) requirements.Add("MFA erforderlich");
        if (item.RequiresApproval) requirements.Add("Genehmigung erforderlich");
        return requirements.Count == 0 ? string.Empty : " · " + string.Join("; ", requirements);
    }
    private static string FormatDuration(long seconds) => $"{seconds / 3600m:0.##} h";
    private sealed class RequestForm { public Guid EntitlementId { get; set; } public long RequestedTtlSeconds { get; set; } [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Eine Begründung ist erforderlich.")] public string Reason { get; set; } = string.Empty; public string? TicketReference { get; set; } }
    private sealed class SecondFactorForm { public string Code { get; set; } = string.Empty; }
}

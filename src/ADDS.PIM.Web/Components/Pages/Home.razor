@page "/new-request"
@using Microsoft.Extensions.Localization
@inject IOperatorRequestClient RequestClient
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IStringLocalizer<Home> Localizer
@inject ILogger<Home> Logger

<Fido2Interop />

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">Privileged access</p>
        <h1 id="page-title">@Localizer["MyPermissionsHeading"]</h1>
        <p>@Localizer["IntroText"]</p>
    </div>
</section>

@if (_loading)
{
    <LoadingIndicator Message="@Localizer["LoadingPermissions"]" />
}
else if (_error is not null)
{
    <div class="submission-result failed" role="alert"><p>@_error</p>@if (_showEnrollLink) { <p><NavLink href="/mfa/totp/enroll">@Localizer["SetupFactorLink"]</NavLink></p> }@if (_failedRequestId is not null) { <p>@Localizer["RequestIdLabel"] <code>@_failedRequestId</code></p> }</div>
}
else if (_entitlements.Count == 0)
{
    <div class="prototype-notice" role="status"><strong>@Localizer["NoActivePermissionsHeading"]</strong><span>@Localizer["NoActivePermissionsText"]</span></div>
}
else if (_pendingSecondFactor is not null)
{
    <section class="request-form" aria-labelledby="second-factor-title">
        <h2 id="second-factor-title">@Localizer["ConfirmSecondFactorHeading"]</h2>
        <p>@Localizer["ConfirmSecondFactorIntro"]</p>
        <dl class="second-factor-summary">
            <dt>@Localizer["ActorAccountLabel"]</dt><dd>@_windowsIdentity</dd>
            <dt>@Localizer["TargetAccountLabel"]</dt><dd>@Selected?.TargetAccountDisplayName</dd>
            <dt>@Localizer["GroupLabel"]</dt><dd>@Selected?.TargetGroupDisplayName</dd>
            <dt>@Localizer["ValidUntilLabel"]</dt><dd>@_pendingSecondFactor.ExpiresUtc.ToLocalTime().ToString("t")</dd>
        </dl>
        @if (_secondFactorError is not null)
        {
            <div class="submission-result failed" role="alert">@_secondFactorError</div>
        }
        @{ var allowedTypes = Selected?.AllowedSecondFactorTypes ?? 3; }
        @if ((allowedTypes & 1) != 0)
        {
            <button class="submit-button" type="button" disabled="@_verifyingSecondFactor" @onclick="VerifyFido2SecondFactorAsync">@(_verifyingSecondFactor ? Localizer["VerifyingText"] : Localizer["ConfirmWithPasskeyButton"])</button>
        }
        @if ((allowedTypes & 2) != 0)
        {
            @if (_mfaStatus is { TotpEnrolled: false })
            {
                <div class="submission-result failed" role="alert">
                    <p>@Localizer["NoTotpFactorText"]</p>
                    <NavLink href="/mfa/totp/enroll">@Localizer["SetupFactorLink"]</NavLink>
                </div>
            }
            else
            {
                <EditForm Model="_secondFactorForm" OnValidSubmit="VerifySecondFactorAsync">
                    <div class="field">
                        <label for="totp-code">@Localizer["TotpCodeLabel"]</label>
                        <InputText id="totp-code" @bind-Value="_secondFactorForm.Code" autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
                    </div>
                    <button class="submit-button" type="submit" disabled="@_verifyingSecondFactor">@(_verifyingSecondFactor ? Localizer["VerifyingText"] : Localizer["ConfirmAndExecuteButton"])</button>
                </EditForm>
            }
        }
    </section>
}
else
{
    <section class="request-form" aria-labelledby="form-title">
        <h2 id="form-title">@Localizer["RequestPermissionHeading"]</h2>
        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="field">
                <label for="entitlement">@Localizer["GroupAndTargetAccountLabel"]</label>
                <InputSelect id="entitlement" @bind-Value="_form.EntitlementId" @bind-Value:after="SelectEntitlement">
                    @foreach (var item in _entitlements)
                    {
                        <option value="@item.EntitlementId">@item.TargetGroupDisplayName · @item.TargetAccountDisplayName@DisplayRestriction(item)</option>
                    }
                </InputSelect>
            </div>
            @if (Selected is not null)
            {
                <div class="field">
                    <label for="duration">@Localizer["DurationLabel"]</label>
                    <InputSelect id="duration" @bind-Value="_form.RequestedTtlSeconds">
                        @foreach (var seconds in Durations(Selected))
                        {
                            <option value="@seconds">@FormatDuration(seconds)</option>
                        }
                    </InputSelect>
                    <span class="hint">@Localizer["AllowedDurationHint", FormatDuration(Selected.MinimumTtlSeconds), FormatDuration(Selected.MaximumTtlSeconds), FormatDuration(Selected.TtlStepSeconds)]</span>
                </div>
                <div class="field">
                    <label for="reason">@Localizer["ReasonLabel"] <span aria-hidden="true">*</span></label>
                    <textarea id="reason" @bind="_form.Reason" @bind:event="oninput" rows="5"></textarea>
                </div>
                @if (Selected.RequiresTicket)
                {
                    <div class="field"><label for="ticket">@Localizer["TicketReferenceLabel"] <span aria-hidden="true">*</span></label><InputText id="ticket" @bind-Value="_form.TicketReference" /></div>
                }
                @if (Selected.RequiresSecondFactor)
                {
                    <p class="hint">@Localizer["SecondFactorRequiredHint", SecondFactorLabel(Selected.AllowedSecondFactorTypes)]</p>
                }
                @if (Selected.RequiresApproval)
                {
                    <p class="hint">@Localizer["ApprovalRequiredHint"]</p>
                }
                <button class="submit-button" type="submit" disabled="@_submitting">@(_submitting ? Localizer["SubmittingText"] : Localizer["RequestAccessButton"])</button>
            }
        </EditForm>
        @if (_result is not null) { <div class="request-status-panel submission-result @ResultVariant(_result.Status)" role="status"><h3>@Localizer["StatusLabel", _result.Status]</h3>@if (!string.IsNullOrWhiteSpace(_result.OutcomeMessage)) { <p>@_result.OutcomeMessage</p> }<p>@Localizer["RequestIdLabel"] <code class="@(_result.Status == "Succeeded" ? "request-id-success" : null)">@_result.RequestId</code></p></div> }
    </section>
}

@code {
    private readonly RequestForm _form = new();
    private readonly SecondFactorForm _secondFactorForm = new();
    private IReadOnlyList<MyAvailableMembershipEntitlement> _entitlements = [];
    private MembershipRequestAccepted? _result;
    private MembershipRequestPendingSecondFactor? _pendingSecondFactor;
    private MyMfaStatusResponse? _mfaStatus;
    private string? _error;
    private string? _secondFactorError;
    private string? _windowsIdentity;
    private Guid? _failedRequestId;
    private bool _showEnrollLink;
    private bool _loading = true, _submitting, _verifyingSecondFactor;
    private MyAvailableMembershipEntitlement? Selected => _entitlements.SingleOrDefault(item => item.EntitlementId == _form.EntitlementId);

    protected override async Task OnInitializedAsync()
    {
        _windowsIdentity = HttpContextAccessor.HttpContext?.User.Identity?.Name;
        try { _entitlements = await RequestClient.ListAvailableEntitlementsAsync(CancellationToken.None); if (_entitlements.Count > 0) SelectEntitlement(); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load available entitlements."); _error = Localizer["LoadEntitlementsError"]; }
        finally { _loading = false; }
        try { _mfaStatus = await RequestClient.GetMfaStatusAsync(CancellationToken.None); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load MFA status for home page."); _mfaStatus = null; }
    }

    private void SelectEntitlement()
    {
        var item = Selected ?? _entitlements[0]; _form.EntitlementId = item.EntitlementId; _form.RequestedTtlSeconds = item.DefaultTtlSeconds; _form.TicketReference = string.Empty;
    }
    private void ResetFormAfterCompletion()
    {
        _form.Reason = string.Empty;
        SelectEntitlement();
    }
    private async Task SubmitAsync()
    {
        var item = Selected; if (item is null) return;
        if (item.RequiresTicket && string.IsNullOrWhiteSpace(_form.TicketReference)) { _error = Localizer["TicketRequiredError"]; return; }
        _submitting = true; _error = null; _failedRequestId = null; _showEnrollLink = false; _result = null;
        try
        {
            var submission = await RequestClient.SubmitAsync(item.TargetAccountId, item.TargetGroupId, _form.RequestedTtlSeconds, _form.Reason, _form.TicketReference, CancellationToken.None);
            if (submission.PendingSecondFactor is not null) { _pendingSecondFactor = submission.PendingSecondFactor; _secondFactorForm.Code = string.Empty; }
            else { _result = submission.Accepted; ResetFormAfterCompletion(); }
        }
        catch (MembershipRequestSubmissionException exception)
        {
            _failedRequestId = exception.RequestId;
            if (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity && exception.ProblemTitle == "No active second factor is enrolled for this account.")
            {
                var allowsTotp = (item.AllowedSecondFactorTypes & 2) != 0;
                _error = $"{Localizer["NoActiveFactorError", SecondFactorLabel(item.AllowedSecondFactorTypes)]}{(allowsTotp ? Localizer["SetupFactorSuffix"] : Localizer["Fido2UnavailableSuffix"])}";
                _showEnrollLink = allowsTotp;
            }
            else if (exception.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity)
            {
                _error = Localizer["InvalidTicketPatternError"];
            }
            else
            {
                _error = Localizer["SubmitFailedWithIdError"];
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Membership request submission failed for TargetGroupId {TargetGroupId}.", item.TargetGroupId); _error = Localizer["SubmitFailedGenericError"]; }
        finally { _submitting = false; }
    }
    private async Task VerifySecondFactorAsync()
    {
        var pendingSecondFactor = _pendingSecondFactor;
        if (pendingSecondFactor is null || string.IsNullOrWhiteSpace(_secondFactorForm.Code)) return;
        _verifyingSecondFactor = true; _secondFactorError = null;
        try
        {
            _result = await RequestClient.VerifyTotpSecondFactorAsync(pendingSecondFactor.RequestId, _secondFactorForm.Code, CancellationToken.None);
            _pendingSecondFactor = null;
            ResetFormAfterCompletion();
        }
        catch (MembershipRequestSubmissionException exception)
        {
            _secondFactorError = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.TooManyRequests => Localizer["FactorLockedError"],
                System.Net.HttpStatusCode.Conflict => Localizer["ConfirmationExpiredError"],
                System.Net.HttpStatusCode.NotFound => Localizer["NoPendingConfirmationError"],
                _ => Localizer["CodeNotVerifiedError"]
            };
        }
        catch (Exception ex) { Logger.LogError(ex, "TOTP second-factor verification failed for RequestId {RequestId}.", pendingSecondFactor.RequestId); _secondFactorError = Localizer["CodeNotVerifiedGenericError"]; }
        finally { _verifyingSecondFactor = false; }
    }
    private async Task VerifyFido2SecondFactorAsync()
    {
        var pendingSecondFactor = _pendingSecondFactor;
        if (pendingSecondFactor is null) return;
        _verifyingSecondFactor = true; _secondFactorError = null;
        try
        {
            var options = await RequestClient.GetFido2AssertionOptionsAsync(pendingSecondFactor.RequestId, CancellationToken.None);
            var assertionJson = await JS.InvokeAsync<string>("pimFido2.authenticate", options.OptionsJson);
            _result = await RequestClient.VerifyFido2SecondFactorAsync(pendingSecondFactor.RequestId, assertionJson, CancellationToken.None);
            _pendingSecondFactor = null;
            ResetFormAfterCompletion();
        }
        catch (MembershipRequestSubmissionException exception)
        {
            _secondFactorError = exception.StatusCode switch
            {
                System.Net.HttpStatusCode.Conflict => Localizer["ConfirmationExpiredError"],
                System.Net.HttpStatusCode.NotFound => Localizer["NoPendingConfirmationError"],
                _ => Localizer["PasskeyNotVerifiedError"]
            };
        }
        catch (Exception ex) { Logger.LogError(ex, "FIDO2 second-factor verification failed for RequestId {RequestId}.", pendingSecondFactor.RequestId); _secondFactorError = Localizer["PasskeyNotVerifiedError"]; }
        finally { _verifyingSecondFactor = false; }
    }
    private string SecondFactorLabel(int allowedSecondFactorTypes) => allowedSecondFactorTypes switch
    {
        1 => Localizer["Fido2Label"],
        2 => Localizer["TotpLabel"],
        3 => Localizer["TotpOrFido2Label"],
        _ => Localizer["SecondFactorGenericLabel"]
    };
    private static IEnumerable<long> Durations(MyAvailableMembershipEntitlement item) { for (var value = item.MinimumTtlSeconds; value <= item.MaximumTtlSeconds; value += item.TtlStepSeconds) yield return value; }
    private static string ResultVariant(string status) => status switch
    {
        "Succeeded" => "accepted",
        "AwaitingApproval" => "pending",
        _ => "failed"
    };
    private string DisplayRestriction(MyAvailableMembershipEntitlement item)
    {
        var requirements = new List<string>();
        if (item.RequiresSecondFactor) requirements.Add(Localizer["MfaRequiredTag"]);
        if (item.RequiresApproval) requirements.Add(Localizer["ApprovalRequiredTag"]);
        return requirements.Count == 0 ? string.Empty : " · " + string.Join("; ", requirements);
    }
    private static string FormatDuration(long seconds) => $"{seconds / 3600m:0.##} h";
    private sealed class RequestForm { public Guid EntitlementId { get; set; } public long RequestedTtlSeconds { get; set; } [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Eine Begründung ist erforderlich.")] public string Reason { get; set; } = string.Empty; public string? TicketReference { get; set; } }
    private sealed class SecondFactorForm { public string Code { get; set; } = string.Empty; }
}

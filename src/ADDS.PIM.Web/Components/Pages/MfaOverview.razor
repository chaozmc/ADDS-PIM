@page "/mfa"
@using Microsoft.Extensions.Localization
@inject IOperatorRequestClient RequestClient
@inject IStringLocalizer<MfaOverview> Localizer
@inject ILogger<MfaOverview> Logger

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero" aria-labelledby="page-title">
    <div>
        <p class="eyebrow">@Localizer["Eyebrow"]</p>
        <h1 id="page-title">@Localizer["Heading"]</h1>
        <p>@Localizer["IntroText"]</p>
    </div>
</section>

@if (_loading)
{
    <LoadingIndicator Message="@Localizer["LoadingStatusMessage"]" />
}
else if (_error is not null)
{
    <div class="submission-result failed" role="alert">@_error</div>
}
else
{
    <div class="mfa-tiles">
        <section class="mfa-tile" aria-labelledby="totp-title">
            <h2 id="totp-title"><i class="bi bi-phone" aria-hidden="true"></i> TOTP</h2>
            @if (_status is { TotpEnrolled: true })
            {
                <p>@Localizer["TotpEnrolledText"]@(_status.TotpConfirmedUtc is { } confirmedUtc ? $" ({Localizer["SinceLabel"]} {confirmedUtc.ToLocalTime():g})" : "").</p>
            }
            else
            {
                <p>@Localizer["TotpNotEnrolledText"]</p>
            }
            <NavLink class="submit-button" href="/mfa/totp/enroll">@Localizer["ManageTotpLink"]</NavLink>
        </section>

        <section class="mfa-tile" aria-labelledby="fido2-title">
            <h2 id="fido2-title"><i class="bi bi-fingerprint" aria-hidden="true"></i> FIDO2-Passkeys</h2>
            @if (_status is { Fido2Enrolled: true })
            {
                <p>@Localizer["PasskeysEnrolledCountText", _status.Fido2Credentials.Count]</p>
                <ul>
                    @foreach (var credential in _status.Fido2Credentials)
                    {
                        <li>@(string.IsNullOrWhiteSpace(credential.Label) ? Localizer["PasskeyFallbackLabel"] : credential.Label) &middot; @Localizer["SinceLabel"] @credential.CreatedUtc.ToLocalTime().ToString("g")</li>
                    }
                </ul>
            }
            else
            {
                <p>@Localizer["NoPasskeyText"]</p>
            }
            <NavLink class="submit-button" href="/mfa/fido2/enroll">@Localizer["ManagePasskeysLink"]</NavLink>
        </section>
    </div>
}

@code {
    private MyMfaStatusResponse? _status;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _status = await RequestClient.GetMfaStatusAsync(CancellationToken.None); }
        catch (Exception ex) { Logger.LogError(ex, "Failed to load MFA status overview."); _error = Localizer["StatusLoadError"]; }
        finally { _loading = false; }
    }
}

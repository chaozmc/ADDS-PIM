@page "/my-approvals"
@using Microsoft.Extensions.Localization
@inject IOperatorRequestClient RequestClient
@inject IStringLocalizer<MyApprovals> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="requests-page">
    <p class="eyebrow">@Localizer["Eyebrow"]</p>
    <h1>@Localizer["Heading"]</h1>
    @if (_loading)
    {
        <LoadingIndicator Message="@Localizer["LoadingMessage"]" />
    }
    else if (_error is not null)
    {
        <div class="submission-result failed" role="alert">@_error</div>
    }
    else if (_page is null || _page.TotalCount == 0)
    {
        <EmptyState Icon="bi-check2-square" Title="@Localizer["EmptyStateTitle"]" Description="@Localizer["EmptyStateDescription"]" />
    }
    else
    {
        <div class="request-table-wrap" role="region" aria-label="@Localizer["TableAriaLabel"]" tabindex="0">
            <table class="request-table">
                <thead>
                    <tr><th>@Localizer["DateColumn"]</th><th>@Localizer["PersonColumn"]</th><th>@Localizer["GroupColumn"]</th><th>@Localizer["TargetAccountColumn"]</th><th>@Localizer["DurationColumn"]</th><th>@Localizer["ReasonColumn"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var item in _page.Items)
                    {
                        <tr>
                            <td>@item.CreatedUtc.LocalDateTime.ToString("g")</td>
                            <td>@item.PersonDisplayName</td>
                            <td>@item.TargetGroupDisplayName</td>
                            <td>@item.TargetAccountDisplayName</td>
                            <td>@FormatDuration(item.RequestedTtlSeconds)</td>
                            <td>@item.Reason</td>
                            <td class="request-actions">
                                <button class="btn btn-success btn-sm" disabled="@_deciding" @onclick="() => ApproveAsync(item.RequestId)">@Localizer["ApproveButton"]</button>
                                <button class="btn btn-outline-danger btn-sm" disabled="@_deciding" @onclick="() => OpenRejectDialogAsync(item)">@Localizer["RejectButton"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<ConfirmDialog @ref="_rejectDialog" Title="@Localizer["RejectDialogTitle"]" OnClosed="() => { _rejectTarget = null; _rejectReason = string.Empty; _rejectError = null; }">
    @if (_rejectTarget is not null)
    {
        <p>@_rejectTarget.PersonDisplayName · @_rejectTarget.TargetGroupDisplayName</p>
        @if (_rejectError is not null)
        {
            <p class="alert alert-danger" role="alert">@_rejectError</p>
        }
        <div class="field">
            <label for="reject-reason">@Localizer["RejectReasonLabel"]</label>
            <textarea id="reject-reason" class="form-control" rows="3" @bind="_rejectReason"></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button class="btn btn-secondary" data-bs-dismiss="modal" disabled="@_deciding">@Localizer["CancelButton"]</button>
            <button class="btn btn-danger" @onclick="RejectAsync" disabled="@_deciding">@Localizer["ConfirmRejectButton"]</button>
        </div>
    }
</ConfirmDialog>

@code {
    private PendingApprovalsPage? _page;
    private string? _error;
    private bool _loading = true;
    private bool _deciding;
    private PendingApprovalItem? _rejectTarget;
    private string _rejectReason = string.Empty;
    private string? _rejectError;
    private ConfirmDialog? _rejectDialog;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _page = await RequestClient.ListPendingApprovalsAsync(1, 50, CancellationToken.None);
        }
        catch
        {
            _error = Localizer["LoadError"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(Guid requestId)
    {
        _deciding = true;
        try
        {
            await RequestClient.ApproveMembershipRequestAsync(requestId, CancellationToken.None);
            await LoadAsync();
        }
        catch
        {
            _error = Localizer["ApproveError"];
        }
        finally
        {
            _deciding = false;
        }
    }

    private async Task OpenRejectDialogAsync(PendingApprovalItem item)
    {
        _rejectTarget = item;
        _rejectReason = string.Empty;
        _rejectError = null;
        StateHasChanged();
        await _rejectDialog!.ShowAsync();
    }

    private async Task RejectAsync()
    {
        if (_rejectTarget is null || string.IsNullOrWhiteSpace(_rejectReason)) { _rejectError = Localizer["RejectReasonRequiredError"]; return; }
        _deciding = true;
        try
        {
            _rejectError = null;
            await RequestClient.RejectMembershipRequestAsync(_rejectTarget.RequestId, _rejectReason, CancellationToken.None);
            await _rejectDialog!.HideAsync();
            await LoadAsync();
        }
        catch
        {
            _rejectError = Localizer["RejectError"];
        }
        finally
        {
            _deciding = false;
        }
    }

    private static string FormatDuration(long seconds) => $"{seconds / 3600m:0.##} h";
}

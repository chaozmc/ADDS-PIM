@page "/not-found"
@layout MainLayout
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<NotFound> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">404</p>
        <h1>@Localizer["NotFoundHeading"]</h1>
        <p>@Localizer["NotFoundMessage"]</p>
    </div>
</section>

<NavLink class="btn btn-secondary" href="">@Localizer["BackToHomeLink"]</NavLink>

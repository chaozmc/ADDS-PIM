@page "/"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Welcome> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<section class="welcome-hero">
    <p class="welcome-eyebrow">@Localizer["WelcomeGreeting", (string.IsNullOrWhiteSpace(DisplayName) ? Localizer["WelcomeGreetingDefault"].Value : DisplayName)]</p>
    <h1 class="welcome-title">ADDS-PIM</h1>
    <p class="welcome-subtitle">
        Privileged Identity Management<br />
        <em class="welcome-subtitle-for">for</em><br />
        <span class="welcome-subtitle-ad">Active Directory</span>
    </p>

    <div class="welcome-visual">
        <img src="img/adds-pim-hero.svg" alt="ADDS-PIM – Privileged Identity Management for Active Directory" />
    </div>

    <p class="welcome-tagline">
        @Localizer["Tagline"]
    </p>

    <div class="welcome-actions">
        <NavLink class="submit-button welcome-cta" href="new-request">
            <i class="bi bi-key-fill" aria-hidden="true"></i> @Localizer["RequestAccessLink"]
        </NavLink>
        <NavLink class="welcome-secondary-button" href="requests">
            <i class="bi bi-clock-history" aria-hidden="true"></i> @Localizer["MyRequestsLink"]
        </NavLink>
        <NavLink class="welcome-secondary-button" href="mfa">
            <i class="bi bi-shield-check" aria-hidden="true"></i> @Localizer["MfaLink"]
        </NavLink>
    </div>
</section>

@code {
    [CascadingParameter(Name = "CurrentUserDisplayName")]
    private string? DisplayName { get; set; }
}

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> SharedLocalizer

<div class="danger-zone" role="alert">
    <p>@Message</p>
    @if (ChildContent is not null)
    {
        <div class="mb-3">@ChildContent</div>
    }
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-danger" @onclick="() => OnConfirm.InvokeAsync()" disabled="@(IsBusy || !CanConfirm)">
            @if (IsBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            @(ConfirmLabel ?? SharedLocalizer["ConfirmButton"])
        </button>
        <button type="button" class="btn btn-secondary" @onclick="() => OnCancel.InvokeAsync()" disabled="@IsBusy">@(CancelLabel ?? SharedLocalizer["CancelButton"])</button>
    </div>
</div>

@code {
    /// <summary>Inline (non-modal) confirmation panel for destructive actions, kept maximally visible in-flow rather than behind a dialog.</summary>
    [Parameter] public string Message { get; set; } = string.Empty;

    /// <summary>Optional extra content (e.g. a "type the exact phrase to confirm" input) rendered between the message and the action buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Defaults to the localized "Confirm" label when not supplied by the caller.</summary>
    [Parameter] public string? ConfirmLabel { get; set; }

    /// <summary>Defaults to the localized "Cancel" label when not supplied by the caller.</summary>
    [Parameter] public string? CancelLabel { get; set; }
    [Parameter] public bool IsBusy { get; set; }

    /// <summary>Set to false to keep the confirm button disabled until an extra precondition (e.g. a typed confirmation phrase) is met.</summary>
    [Parameter] public bool CanConfirm { get; set; } = true;

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}

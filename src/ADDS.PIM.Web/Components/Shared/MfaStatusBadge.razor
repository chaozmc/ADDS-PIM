@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject IStringLocalizer<MfaStatusBadge> Localizer

@if (Status is not null)
{
    @if (Status.TotpEnrolled)
    {
        <button type="button" class="pim-badge pim-badge-success" @onclick="ShowTotpDialogAsync">
            <i class="bi bi-shield-check" aria-hidden="true"></i> @Localizer["TotpEnrolledLabel"]
        </button>
    }
    else
    {
        <button type="button" class="pim-badge pim-badge-warning" @onclick="NavigateToTotpEnrollment">
            <i class="bi bi-shield-exclamation" aria-hidden="true"></i> @Localizer["TotpNotEnrolledLabel"]
        </button>
    }
    @if (Status.Fido2Available)
    {
        @if (Status.Fido2Enrolled)
        {
            <button type="button" class="pim-badge pim-badge-success" @onclick="ShowFido2DialogAsync">
                <i class="bi bi-shield-check" aria-hidden="true"></i> @Localizer["Fido2EnrolledLabel"]
            </button>
        }
        else
        {
            <button type="button" class="pim-badge pim-badge-warning" @onclick="NavigateToFido2Enrollment">
                <i class="bi bi-shield-exclamation" aria-hidden="true"></i> @Localizer["Fido2NotEnrolledLabel"]
            </button>
        }
    }

    <ConfirmDialog @ref="_totpDialog" Title="@Localizer["TotpDialogTitle"]">
        <div class="mfa-status-modal">
            <i class="bi bi-check-circle-fill mfa-status-modal-icon" aria-hidden="true"></i>
            <p>@Localizer["TotpDialogMessage"]</p>
            @if (Status.TotpConfirmedUtc is { } confirmedUtc)
            {
                <p class="hint">@Localizer["EnrolledOnPrefix"] @confirmedUtc.ToLocalTime().ToString("g")</p>
            }
        </div>
    </ConfirmDialog>

    @if (Status.Fido2Available)
    {
        <ConfirmDialog @ref="_fido2Dialog" Title="@Localizer["Fido2DialogTitle"]">
            <div class="mfa-status-modal">
                <i class="bi bi-check-circle-fill mfa-status-modal-icon" aria-hidden="true"></i>
                <p>@Localizer["Fido2DialogMessage"]</p>
                @if (Status.Fido2ConfirmedUtc is { } fido2ConfirmedUtc)
                {
                    <p class="hint">@Localizer["EnrolledOnPrefix"] @fido2ConfirmedUtc.ToLocalTime().ToString("g")</p>
                }
            </div>
        </ConfirmDialog>
    }
}

@code {
    [Parameter] public MyMfaStatusResponse? Status { get; set; }

    private ConfirmDialog? _totpDialog;
    private ConfirmDialog? _fido2Dialog;

    private void NavigateToTotpEnrollment() => NavigationManager.NavigateTo("/mfa/totp/enroll");
    private void NavigateToFido2Enrollment() => NavigationManager.NavigateTo("/mfa/fido2/enroll");
    private Task ShowTotpDialogAsync() => _totpDialog?.ShowAsync() ?? Task.CompletedTask;
    private Task ShowFido2DialogAsync() => _fido2Dialog?.ShowAsync() ?? Task.CompletedTask;
}
